---
/**
 * About Hailey.
 *
 * Hailey's own words, on the Option F system: arch-shaped media, rose/beige
 * grounds, the semantic tokens from global.css. Two movements —
 *
 *   1. The family story (photo-paired, warm, one paragraph per threshold).
 *   2. "How I got called into the birth space" (the vocational essay).
 *
 * The essay keeps Hailey's phrasing and rhythm verbatim; only the casing is
 * normalised to sentences (her source copy was typed lowercase throughout).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import SectionCurve from '../components/SectionCurve.astro';
import { Image } from 'astro:assets';
import { reveal, stagger } from '../lib/reveal';

import familyStanding from '../assets/images/about/imgi_2_483237453cc84278863b345009418cf417d61a9f6a26424e905972b325f8640d-md.jpg';
import haileyEmerson from '../assets/images/about/imgi_3_ef01762d21614546b59b9dab7be155fd243b2640b3034f27b801b73cf78b9b67-md.jpg';
import haileyKoa from '../assets/images/about/imgi_4_d8d4682145ac41b9b9b8116bc567771eb8eb4d9a0efb41c3be6ff3f6d8fb5739-md.jpg';
import haileyHarvest from '../assets/images/about/imgi_5_cd5816f7e41c4b7dbe5ada92f4089b63c782ccb17dee429daeaecc9652d3d681-md.jpg';
import familyWalking from '../assets/images/about/imgi_6_1a01a034f25547f9b54e7da008397cecda952246575e4e64acf1a293f1ef0ae1-md.jpg';
import bellyField from '../assets/images/about/imgi_26_eb03179c273c47ee9c70e670f332d2f08a2c780bfeb9431fad1c7d3a60a247e5-md.jpg';
import familyPhoto from '../assets/images/family-photo.jpg';

/**
 * Video links.
 *
 * Hailey's source copy points at three videos with the word "HERE". Bare "here"
 * is poor link text (a screen reader reading the page's links out of context
 * gets three identical "here"s), so each one is given a description of where it
 * actually goes.
 *
 * Set to null until the real URLs are known. Each link renders ONLY when its URL
 * is filled in, so the page never ships a dead `#` anchor — drop a URL in and
 * the link appears.
 */
const videos = {
  emersonStory: null as string | null,
  koaBirth: null as string | null,
  harvestBirth: null as string | null,
};

/** The two home births, in order. */
const births = [
  {
    name: 'Koa Bane',
    meaning: '“brave; long-awaited one”',
    image: haileyKoa,
    alt: 'Hailey laughing as she carries her son Koa on her hip at the beach, pregnant with her fourth',
    /* Her face sits high in this frame; a shared 30% crop cut it off. */
    focus: '50% 14%',
    copy:
      'When Emerson was 15 months old, I miraculously got pregnant with our son, Koa Bane.',
    href: videos.koaBirth,
    linkLabel: 'Watch Koa’s home birth',
  },
  {
    name: 'Harvest Joy',
    meaning: '“Those who sow in tears will reap a harvest of joy.”',
    scripture: 'Psalm 126:5',
    image: haileyHarvest,
    alt: 'Hailey sitting in the dune grass and sand, holding her daughter Harvest in her lap',
    focus: '50% 34%',
    copy: 'And 15 months later, along came Harvest Joy.',
    href: videos.harvestBirth,
    linkLabel: 'Watch Harvest’s home birth',
  },
];
---

<BaseLayout
  title="About Hailey"
  description="Meet Hailey Joy Aliff — second-generation midwife, doula, childbirth educator, and mother of four — and the story of how she was called into the birth space."
>
  <!-- ───────────────────────── hero ───────────────────────── -->
  <section class="hero">
    <div class="hero-wash" aria-hidden="true"></div>

    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">About Hailey</p>

        <h1>Meet Hailey <span class="signature-accent">Joy</span> Aliff</h1>

        <p class="lede">
          This is my husband, Jeremy, and our four kiddos — Emerson, Koa, Harvest,
          and baby still in the belly.
        </p>

        <p class="sub">
          Second-generation midwife, doula, and childbirth educator. I learned birth at
          my mother’s side long before I ever carried life of my own.
        </p>
      </div>

      <div class="stage">
        <div class="halo" aria-hidden="true"></div>

        <figure class="arch">
          <Image
            src={familyStanding}
            alt="Hailey and Jeremy Aliff standing together on a white sand beach with their three children, Hailey holding the youngest on her hip"
            class="photo"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 44vw, 90vw"
            priority
          />
        </figure>
      </div>
    </div>
  </section>

  <SectionCurve from="#fcf5f1" to="var(--bg-soft)" />

  <!-- ──────────────────── the seven-year wait ──────────────────── -->
  <section class="wait">
    <div class="wait-grid">
      <div class="stage stage-left" {...reveal()}>
        <div class="halo" aria-hidden="true"></div>

        <figure class="arch">
          <Image
            src={haileyEmerson}
            alt="Hailey standing at the water’s edge in a floral dress, her daughter Emerson pressing her face against her pregnant belly"
            class="photo"
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 42vw, 90vw"
          />
        </figure>
      </div>

      <div class="wait-copy" {...reveal(160)}>
        <p class="eyebrow">The winter wait</p>

        <h2>Seven years of waiting, then a daughter</h2>

        <p class="body">
          We have been married for 11 years, and for the first 7 years of our marriage
          we struggled to conceive. (I’m currently working on a Holistic Fertility Ebook
          to share a lot of the knowledge we gained in that winter wait.)
        </p>

        <p class="body">
          We knew before getting married that we would adopt one day, so we first became
          parents through the miracle of adoption.
        </p>

        <div class="named">
          <p class="named-name">Emerson Faith</p>
          <p class="named-meaning">
            Emerson means <em>“brave”</em> — and her birth mother, who we keep in touch
            with today, gave her the middle name <em>“faith”</em>.
          </p>
          <p class="body">
            It’s wild to think she is about to be the big sis of 3 little siblings.
          </p>
          {
            videos.emersonStory && (
              <a class="link-cta" href={videos.emersonStory} target="_blank" rel="noreferrer">
                Watch Emerson’s adoption story <span class="arrow" aria-hidden="true">→</span>
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────────────── the two home births ───────────────────── -->
  <section class="births">
    <div class="wrap">
      <div class="sec-head" {...reveal()}>
        <p class="eyebrow">Then came springtime</p>
        <h2>Two home births, fifteen months apart</h2>
        <p class="sec-sub">
          After answering the call to adopt our daughter, our springtime came — and I
          got to experience birth in the way I already knew it was meant to be.
        </p>
      </div>

      <div class="birth-grid">
        {
          births.map((b, i) => (
            <article class="birth-card" {...reveal(stagger(i, 120))}>
              <div class="birth-media">
                <Image
                  src={b.image}
                  alt={b.alt}
                  widths={[480, 720, 960]}
                  sizes="(min-width: 900px) 44vw, 100vw"
                  style={`object-position: ${b.focus}`}
                />
              </div>

              <div class="birth-copy">
                <h3>{b.name}</h3>
                <p class="birth-meaning">
                  {b.meaning}
                  {b.scripture && <span class="scripture">{b.scripture}</span>}
                </p>
                <p class="body">{b.copy}</p>
                {
                  b.href && (
                    <a class="link-card" href={b.href} target="_blank" rel="noreferrer">
                      <span>{b.linkLabel}</span>
                      <span class="arrow" aria-hidden="true">→</span>
                    </a>
                  )
                }
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ─────────────── full-bleed band into the essay ─────────────── -->
  <div class="band">
    <Image
      src={familyWalking}
      alt="The whole Aliff family walking hand in hand across an open stretch of white sand beach"
      widths={[720, 1080, 1440]}
      sizes="100vw"
      data-scroll-scale-image
      style="transform: scale(1.04);"
    />
  </div>

  <!-- ─────────────────────── the vocation essay ─────────────────────── -->
  <!-- Hailey's words verbatim, sentence-cased. -->
  <section class="calling">
    <div class="essay">
      <div class="essay-head" {...reveal()}>
        <p class="eyebrow">Her calling</p>
        <h2>How I got called into the birth space</h2>
      </div>

      <div class="prose" {...reveal(120)}>
        <p>
          The calling to preserve birth and experience God’s hand in it started for me
          long before I ever carried life in my womb or gave birth myself. In fact, it
          started as a young child as I observed homebirths alongside my mama who was a
          lay midwife. Before the time I was even in high school I believed in birth, was
          awe-inspired by it, and knew it was God’s gift to women (not a curse).
        </p>

        <p>
          I pursued this calling into college shadowing OB’s and DO’s and interning at
          clinics trying to figure out which direction I would take being a birthworker.
          After a year of seeing mainly medicated births and surgical births, I decided I
          would pursue midwifery school.
        </p>

        <p>
          Before starting midwifery school, I imagined I would start natural birth clinics
          in 3rd world countries. By the time I graduated, I realized that first world
          countries might have a bigger need. Progress has certainly not done better for
          the design of birth.
        </p>

        <p>
          In 1989 (the year I was born) c-section rates were at 19%. A lot has changed
          since then and as of 2022, the U.S. sits at an average of 32.1%. According to
          the CDC, the overall cesarean delivery rate in the U.S. increased 60% between
          1996 and 2009. It’s safe to say we’ve lost touch with the natural process of how
          things were meant to go and they are only declining.
        </p>
      </div>

      <figure class="inset" {...reveal()}>
        <Image
          src={bellyField}
          alt="A close view of a pregnant belly in a dotted cotton dress, hands resting underneath, in a field of tall grass at golden hour"
          widths={[480, 720]}
          sizes="(min-width: 720px) 34rem, 100vw"
        />
      </figure>

      <div class="prose" {...reveal(120)}>
        <p>
          I graduated midwifery school a year after getting married and we could not wait
          to have kids. Jeremy wrote in his vows “I can’t wait to make a million babies
          with you” and we really thought we would be parents soon. 7 years went by and I
          became more involved with and enthralled by birth. Equally the longing to
          experience it myself ached.
        </p>

        <p>
          I shadowed three different midwives, finished all my numbers for licensure, and
          then I never sat for the test. My heart was in my doula business and childbirth
          education ministry. The medical role in birth didn’t fuel me as much as the
          support role in birth. Both are needed and have their special place and I was
          niching down into mine.
        </p>

        <p>
          After answering the call to adopt our daughter, our springtime came and I became
          pregnant with my son. I experienced birth in the way that I already knew it was
          meant to be. Two years later giving birth to my daughter I got to experience the
          joy-within even deeper.
        </p>
      </div>

      <blockquote class="pull" {...reveal()}>
        <p>
          When I say I look forward to giving birth I mean it. It’s like a glimpse of
          heaven touching earth every single time.
        </p>
      </blockquote>
    </div>
  </section>

  <!-- ───────────────────────── the closing ───────────────────────── -->
  <section class="closing">
    <div class="closing-grid">
      <div class="closing-copy" {...reveal()}>
        <p class="closing-eyebrow">A note from Hailey</p>

        <p class="closing-lede">
          I’m so glad you’re here. I’ve prayed for you to be here, and it’s my honor to
          pass this birth knowledge onto you.
        </p>

        <p class="signature">
          <span class="signature-dash" aria-hidden="true"></span>
          <span class="signature-name">Hailey</span>
        </p>
      </div>

      <figure class="candid" {...reveal(160)}>
        <Image
          src={familyPhoto}
          alt="The Aliff family together in a mountain meadow"
          widths={[360, 540]}
          sizes="(min-width: 900px) 20rem, 60vw"
        />
        <figcaption>Our family today.</figcaption>
      </figure>
    </div>
  </section>

  <CtaBand
    heading="I'd be honored to walk this season with you"
    subheading="Enroll in Joy Within Birth and gain lifetime access to the course, the community, and Hailey herself."
    capFrom="var(--surface)"
  />
</BaseLayout>

<style>
  /* ═══════════════════════════ hero ═══════════════════════════ */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #fcf5f1;
  }
  .hero-wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(86% 78% at 82% 4%, var(--rose-100) 0%, rgba(246, 227, 218, 0) 62%),
      radial-gradient(58% 54% at 98% 58%, rgba(232, 207, 200, 0.8) 0%, rgba(232, 207, 200, 0) 68%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 0.92fr;
    gap: 72px;
    align-items: center;
    max-width: var(--layout-max);
    margin: 0 auto;
    padding: var(--space-section-md) var(--layout-gutter) var(--space-section-lg);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: var(--type-label);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }
  .eyebrow::before {
    content: '';
    width: 40px;
    height: 1px;
    background: var(--border-subtle);
  }

  h1 {
    margin-top: 24px;
    font-size: var(--type-display);
    line-height: 1.04;
    text-wrap: balance;
  }

  .lede {
    margin-top: 26px;
    max-width: 30em;
    font-size: var(--type-lead);
    line-height: 1.76;
    color: var(--text-secondary);
  }

  .sub {
    margin-top: 18px;
    max-width: 32em;
    font-size: var(--type-body);
    line-height: 1.8;
    color: var(--text-muted);
  }

  /* ══════════════════ the shared arch treatment ══════════════════ */
  /* Same silhouette as the home page's Meet Hailey block: a dome with the
     hairline rule set inside its edge and a rose halo tracing just outside. */
  .stage {
    position: relative;
    width: 100%;
    max-width: 470px;
    justify-self: end;
  }

  .arch {
    position: relative;
    margin: 0;
    aspect-ratio: 2 / 3;
    border-radius: 300px 300px var(--radius-lg) var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 44px 96px -44px rgba(124, 76, 66, 0.5);
  }
  .arch :global(.photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
    filter: saturate(0.92) contrast(1.03);
  }

  /* These beach frames are bright and high-key, so the top of the arch would
     dissolve into the pale ground without a tint holding its silhouette. */
  .arch::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      var(--rose-300) 0%,
      var(--rose-200) 14%,
      rgba(232, 207, 200, 0.55) 26%,
      rgba(232, 207, 200, 0.16) 38%,
      rgba(232, 207, 200, 0) 48%
    );
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .arch::after {
    content: '';
    position: absolute;
    inset: 14px;
    z-index: 2;
    border: 1px solid rgba(255, 253, 250, 0.72);
    border-radius: 288px 288px 20px 20px;
    pointer-events: none;
  }

  .halo {
    position: absolute;
    left: -5.5%;
    right: -5.5%;
    top: -2.5%;
    bottom: 4%;
    border: 1px solid var(--border-subtle);
    border-radius: 320px 320px 26px 26px;
    z-index: -1;
  }

  /* ═════════════════════ the seven-year wait ═════════════════════ */
  .wait {
    background: var(--bg-soft);
    padding: var(--space-section-lg) 0;
  }

  .wait-grid {
    max-width: var(--layout-max);
    margin: 0 auto;
    padding: 0 var(--layout-gutter);
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: 84px;
    align-items: center;
  }

  .stage-left {
    justify-self: start;
  }

  .wait-copy h2 {
    margin-top: 22px;
    font-size: var(--type-section);
    line-height: 1.09;
    max-width: 20ch;
  }

  .body {
    margin-top: 22px;
    max-width: 34em;
    font-size: var(--type-body);
    line-height: 1.8;
    color: var(--text-muted);
  }

  .named {
    margin-top: 32px;
    padding-top: 26px;
    border-top: 1px solid var(--border-subtle);
  }
  .named-name {
    font-size: var(--type-card);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }
  .named-meaning {
    margin-top: 8px;
    max-width: 32em;
    font-size: var(--type-body);
    line-height: 1.75;
    color: var(--text-secondary);
  }
  .named-meaning em {
    font-style: normal;
    font-weight: 700;
    color: var(--accent-strong);
  }
  .named .body {
    margin-top: 14px;
  }
  .named .link-cta {
    margin-top: 20px;
  }

  /* ═══════════════════════ the two births ═══════════════════════ */
  .births {
    background: var(--bg-strong);
    padding: var(--space-section-lg) 0;
  }
  .wrap {
    max-width: var(--layout-max);
    margin: 0 auto;
    padding: 0 var(--layout-gutter);
  }

  .sec-head {
    max-width: 40em;
    margin: 0 auto;
    text-align: center;
  }
  .sec-head .eyebrow {
    justify-content: center;
  }
  .sec-head .eyebrow::before {
    display: none;
  }
  .sec-head h2 {
    margin-top: 16px;
    font-size: var(--type-section);
    line-height: 1.1;
    text-wrap: balance;
  }
  .sec-sub {
    margin-top: 18px;
    font-size: var(--type-lead);
    line-height: 1.8;
    color: var(--text-muted);
    text-wrap: balance;
  }

  .birth-grid {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    max-width: 1040px;
    margin-inline: auto;
  }

  .birth-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface);
    padding: 16px;
    box-shadow: var(--shadow-card);
    transition:
      transform 260ms ease,
      box-shadow 260ms ease;
  }
  .birth-card:hover,
  .birth-card:focus-within {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .birth-media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--bg-page);
  }
  .birth-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* crop comes from each entry's `focus`, art-directed per frame */
    filter: saturate(0.86) contrast(1.03);
    transition: transform 600ms ease;
  }
  .birth-card:hover .birth-media :global(img) {
    transform: scale(1.04);
  }
  /* One rose grade over both frames so the pair reads as a set. */
  .birth-media::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--rose-400);
    mix-blend-mode: color;
    opacity: 0.22;
    pointer-events: none;
  }

  .birth-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 22px 8px 8px;
  }
  .birth-copy h3 {
    font-size: var(--type-card);
    font-weight: 800;
    line-height: 1.25;
  }
  .birth-meaning {
    margin-top: 8px;
    font-size: var(--type-body);
    font-style: italic;
    line-height: 1.65;
    color: var(--accent-strong);
  }
  .scripture {
    display: block;
    margin-top: 6px;
    font-size: var(--type-label);
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .birth-copy .body {
    margin-top: 12px;
    font-size: var(--type-small);
    line-height: 1.7;
  }
  .birth-copy .link-card {
    margin-top: auto;
    padding-top: 16px;
  }

  /* ══════════════════════ full-bleed band ══════════════════════ */
  .band {
    position: relative;
    overflow: hidden;
    height: clamp(320px, 52vw, 660px);
    background: var(--bg-page);
  }
  .band :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
    filter: saturate(0.94) contrast(1.04);
  }
  /* Feathered top and bottom so the band dissolves into the sections either
     side instead of arriving as two hard rules. */
  .band::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, var(--bg-strong) 0%, rgba(244, 224, 214, 0) 16%),
      linear-gradient(to top, var(--bg-page) 0%, rgba(252, 246, 241, 0) 11%);
  }

  /* ════════════════════════ the essay ════════════════════════ */
  .calling {
    background: var(--bg-page);
    padding: var(--space-section-lg) 0;
  }

  .essay {
    max-width: 42rem;
    margin: 0 auto;
    padding: 0 var(--layout-gutter);
  }

  .essay-head {
    text-align: center;
  }
  .essay-head .eyebrow {
    justify-content: center;
  }
  .essay-head .eyebrow::before {
    display: none;
  }
  .essay-head h2 {
    margin-top: 16px;
    font-size: var(--type-section-compact);
    line-height: 1.12;
    text-wrap: balance;
  }

  .prose {
    margin-top: 40px;
  }
  .prose p {
    margin-top: 22px;
    font-size: var(--type-lead);
    line-height: 1.85;
    color: var(--text-secondary);
  }
  .prose p:first-child {
    margin-top: 0;
  }

  .inset {
    margin: 44px 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .inset :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .pull {
    margin: 48px 0 0;
    padding: 32px 0 0;
    border-top: 1px solid var(--border-subtle);
    text-align: center;
  }
  .pull p {
    max-width: 26em;
    margin: 0 auto;
    font-family: 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
