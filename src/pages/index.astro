---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import CtaBand from '../components/CtaBand.astro';
import Hero from '../components/home/Hero.astro';
import JourneySection from '../components/home/JourneySection.astro';
import BirthWithoutFear from '../components/home/BirthWithoutFear.astro';
import MeetHailey from '../components/home/MeetHailey.astro';
import ProblemStatement from '../components/home/ProblemStatement.astro';
import TestimonialCarousel from '../components/home/TestimonialCarousel.astro';
import PartnerModule from '../components/home/PartnerModule.astro';
import SectionCurve from '../components/SectionCurve.astro';
import { reveal, stagger } from '../lib/reveal';
import element6 from '../assets/images/elements/6.png';
import dreamBirthImage from '../assets/images/imgi_26_689ec9cc5dc21c83efcd4588.jpg';
import laborFlowImage from '../assets/images/imgi_11_689cede83b01e6b095436d26.jpg';
import ebookImage from '../assets/images/imgi_8_689ec538c6ba4e09e29cc249.jpg';



const freebies = [
  {
    image: dreamBirthImage,
    imageAlt: 'Sunset over mountains and water, representing a peaceful dream birth visualization.',
    title: 'How to Visualize Your Dream Birth',
    description:
      'A free class to help you map your dream birth and start preparing with confidence.',
    type: 'Free class',
    cta: 'Watch free class',
    href: 'https://joywithinbirth.myflodesk.com/',
  },
  {
    image: laborFlowImage,
    imageAlt: 'A mother laboring in water with steady birth support nearby.',
    title: 'Flow for Each Stage of Labor',
    description:
      'Movement & mindset flow to reduce fear and build joy as you prepare for birth.',
    type: 'Free class',
    cta: 'Watch free class',
    href: 'https://joywithinbirth.myflodesk.com/',
  },
  {
    image: ebookImage,
    imageAlt: 'A pregnant mother journaling with a laptop while preparing for birth.',
    title: '5 Keys to Joy Within Birth (Ebook)',
    description:
      'A simple, hope-filled guide to prepare your heart and mind for a peaceful birth.',
    type: 'Ebook',
    cta: 'Get the free ebook',
    href: 'https://joywithinbirth.myflodesk.com/',
  },
];

---

<BaseLayout
  title="Home"
  description="A faith-centered natural childbirth training and community, built by a second-generation midwife, walking you from fertility through postpartum."
>
  <Hero />

  <ProblemStatement />

  <MeetHailey />

  <SectionCurve from="var(--rose-50)" to="var(--rose-75)" />

  <JourneySection />

  <BirthWithoutFear />

  <section
    class="freebies-section"
    x-data="{
      updateScrollScaleImages() {
        const viewportHeight = window.innerHeight;

        document.querySelectorAll('[data-scroll-scale-image]').forEach((image) => {
          const frame = image.parentElement;
          const rect = frame.getBoundingClientRect();

          if (rect.bottom < 0 || rect.top > viewportHeight) return;

          const progress = Math.min(1, Math.max(0, (viewportHeight - rect.top) / (viewportHeight + rect.height)));
          const scale = 1.04 + progress * 0.16;

          image.style.transform = `scale(${scale})`;
        });
      }
    }"
    x-init="
      updateScrollScaleImages();
      window.addEventListener('scroll', () => requestAnimationFrame(() => updateScrollScaleImages()), { passive: true });
      window.addEventListener('resize', () => requestAnimationFrame(() => updateScrollScaleImages()), { passive: true });
    "
  >
    <Image src={element6} alt="" aria-hidden="true" class="freebies-flower" />

    <div class="freebies-head" {...reveal()}>
      <p class="freebies-eyebrow">Free resources</p>
      <h2>Start learning for free</h2>
      <p class="freebies-intro">
        Begin with practical, hope-filled guidance created to help you prepare for birth
        with more calm, clarity, and confidence.
      </p>
    </div>

    <div class="freebies-grid">
      {freebies.map((item, i) => (
        <article class="freebie-card" {...reveal(stagger(i, 90))}>
          <div class="freebie-image">
            <Image
              src={item.image}
              alt={item.imageAlt}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 29vw, (min-width: 640px) 44vw, 100vw"
              style="transform: scale(1.04);"
              data-scroll-scale-image
            />
          </div>
          <div class="freebie-copy">
            <p class="freebie-type">{item.type}</p>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <a class="freebie-link link-card" href={item.href} target="_blank" rel="noreferrer">
              <span>{item.cta}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

  </section>

  <PartnerModule />

  <TestimonialCarousel />

  <CtaBand
    heading="You are not meant to walk this alone"
    subheading="Enroll once, gain lifetime access, and join a community of women walking this same sacred road beside you."
  />
</BaseLayout>

<style>
  .freebies-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: var(--space-section-md) 0 var(--space-section-sm);
    background: linear-gradient(180deg, var(--bg-soft) 0%, var(--bg-soft) 45%, var(--surface) 100%);
  }

  .freebies-flower {
    pointer-events: none;
    position: absolute;
    right: 2.5rem;
    bottom: 0.5rem;
    z-index: -1;
    display: none;
    width: 11rem;
    rotate: 12deg;
    opacity: 0.06;
    mix-blend-mode: multiply;
  }

  .freebies-head {
    max-width: 42rem;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  .freebies-eyebrow {
    color: var(--accent-strong);
    font-size: var(--type-label);
    font-weight: 600;
    letter-spacing: 0.025em;
    text-transform: uppercase;
  }

  .freebies-head h2 {
    margin-top: 12px;
    font-size: var(--type-section);
    line-height: 1.15;
    text-wrap: balance;
  }

  .freebies-intro {
    max-width: 38rem;
    margin: 18px auto 0;
    color: var(--text-muted);
    font-size: var(--type-lead);
    line-height: 1.8;
    text-wrap: balance;
  }

  .freebies-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    max-width: var(--layout-max);
    margin: 52px auto 0;
    padding: 0 var(--layout-gutter);
  }

  .freebie-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface);
    padding: 16px;
    box-shadow: var(--shadow-card);
    transition:
      transform 260ms ease,
      box-shadow 260ms ease;
  }

  .freebie-card:hover,
  .freebie-card:focus-within {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .freebie-image {
    aspect-ratio: 1.78 / 1;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--bg-page);
  }

  .freebie-image::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--rose-400);
    mix-blend-mode: color;
    opacity: 0.32;
    pointer-events: none;
  }

  .freebie-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.78) contrast(1.04) brightness(1.02);
    transition: transform 600ms ease;
  }

  .freebie-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 16px 0 0;
  }

  .freebie-type {
    margin: 0;
    color: var(--accent-strong);
    font-size: var(--type-label);
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .freebie-copy h3 {
    margin-top: 6px;
    max-width: 18em;
    font-size: var(--type-card);
    font-weight: 700;
    line-height: 1.25;
    text-wrap: balance;
  }

  .freebie-copy > p:not(.freebie-type) {
    margin-top: 8px;
    max-width: 24em;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.65;
  }

  .freebie-link {
    margin-top: auto;
    padding-top: 14px;
  }

  .freebie-card:hover .freebie-link .arrow,
  .freebie-card:focus-within .freebie-link .arrow {
    transform: translateX(3px);
  }

  @media (max-width: 980px) {
    .freebies-grid {
      grid-template-columns: 1fr;
      max-width: 640px;
    }

    .freebie-copy h3,
    .freebie-copy p {
      max-width: none;
    }
  }

  @media (min-width: 1024px) {
    .freebies-flower {
      display: block;
    }
  }

  @media (min-width: 1280px) {
    .freebies-flower {
      width: 15rem;
    }
  }

  @media (max-width: 640px) {
    .freebies-section {
      padding: var(--space-section-md) 0 var(--space-section-sm);
    }

    .freebies-grid {
      gap: 20px;
    }

    .freebie-copy {
      padding-top: 16px;
    }
  }
</style>
