---
/**
 * Pricing & FAQ (the /enroll route, linked as "Pricing" in the nav).
 *
 * An earlier pass was two feature-list boxes side by side — competent, and the
 * most templated pricing layout there is. This one sells in the hero (price,
 * what it buys, primary action, beside the outcome you are buying), treats the
 * VIP tier as a high-touch next step, and puts proof at the point of decision
 * instead of leaving the page proof-free.
 *
 * Deliberately absent: any "compare us to a doula / hospital class" price
 * anchoring. Those figures vary hugely by region and none is sourced anywhere
 * in this project, so inventing them would put an unverifiable claim on the
 * page where it is most likely to be believed.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqItem from '../components/FaqItem.astro';
import SectionCurve from '../components/SectionCurve.astro';
import { Image } from 'astro:assets';
import { reveal, stagger } from '../lib/reveal';
import { ArrowDown, Check } from '@lucide/astro';

import heroImage from '../assets/images/aliff-bluey-04.jpg';
import vipImage from '../assets/images/imgi_10_689cf0151f951ee0b182e811.jpg';

import { testimonials } from '../data/testimonials';

const SKOOL_URL = 'https://www.skool.com/joywithinbirth/about';
const HAILEY_IG = 'https://www.instagram.com/haileyaliff/';

/** What the price buys, in figures. */
const atAGlance = [
  { figure: '9', label: 'Modules' },
  { figure: '10+', label: 'Hours of training' },
  { figure: 'Lifetime', label: 'Access' },
  { figure: '$0', label: 'Recurring' },
];

/**
 * Core features, grouped. A flat list of nine checkmarks reads as a wall; the
 * groups let someone find the part they actually care about. Three items per
 * group, so the three cards sit level rather than one running short.
 */
const coreGroups = [
  {
    title: 'The training',
    items: [
      'Full 9-module course, 10+ hours',
      'Birth plan templates, guides & checklists',
      'Dedicated birth partner training module',
    ],
  },
  {
    title: 'The support',
    items: [
      'Private community on Skool',
      'Monthly live group Q&A coaching',
      'In-portal messaging with Hailey',
    ],
  },
  {
    title: 'The access',
    items: [
      'Lifetime access & future updates',
      'Yours again for future pregnancies',
      'Self-paced, revisit any module anytime',
    ],
  },
];

const vipFeatures = [
  'Everything in the full enrollment',
  'Private 1:1 coaching, custom plan',
  'Additional postpartum support session',
  'Priority access to Hailey',
];

/** Proof at the decision point. Pulled from the data, not retyped. */
const proofQuote = testimonials.find((t) => t.name === 'Kari L.') ?? testimonials[0];
---

<BaseLayout
  title="Pricing & FAQ"
  description="Enroll in Joy Within Birth for $350, one-time, lifetime access. See what's included, explore personalized VIP support, and get answers to common questions."
>
  <!-- ───────── hero: the price, what it buys, and the outcome ───────── -->
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Enroll</p>

        <h1>One enrollment.<br /><span class="signature-accent">Joy</span> for life.</h1>

        <p class="lede">
          No subscriptions, no recurring fees. Just one trusted place to prepare, for as
          long as your journey takes.
        </p>

        <div class="offer">
          <div class="price-row">
            <p class="amount">$350</p>
            <p class="price-meta">
              <strong>One-time payment</strong>
              <span>Lifetime access · Future updates included</span>
            </p>
          </div>

          <div class="action-row">
            <a class="btn-grad btn-lg" href={SKOOL_URL} target="_blank" rel="noreferrer">
              Enroll Now
            </a>
            <a class="included-link" href="#included">
              <span>See everything included</span>
              <ArrowDown aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </div>

    <figure class="hero-media">
      <span class="grade" aria-hidden="true"></span>
      <Image
        src={heroImage}
        alt="The Aliff family standing together outdoors with their children and dogs"
        class="photo"
        style="transform: scale(1.04);"
        data-scroll-scale-image
        widths={[720, 1080, 1440]}
        sizes="(min-width: 1024px) 52vw, 100vw"
        priority
      />
    </figure>

    <SectionCurve from="transparent" to="var(--bg-soft)" overlay />
  </section>

  <!-- ───────────────────── what's included, grouped ───────────────────── -->
  <section class="included" id="included">
    <div class="wrap">
      <div class="sec-head" {...reveal()}>
        <p class="eyebrow">What's included</p>
        <h2>Everything you need, from fertility to postpartum</h2>
      </div>

      {/* The figures used to sit in the hero under the price, where they
          competed with the one action on the page. They belong here, as the
          headline numbers for what the enrollment actually contains. */}
      <dl class="glance" {...reveal(80)}>
        {
          atAGlance.map((g) => (
            <div>
              <dt>{g.figure}</dt>
              <dd>{g.label}</dd>
            </div>
          ))
        }
      </dl>

      <div class="group-grid">
        {
          coreGroups.map((group, i) => (
            <article class="group" {...reveal(stagger(i, 90))}>
              <h3>{group.title}</h3>
              <ul>
                {
                  group.items.map((item) => (
                    <li>
                      <span class="tick" aria-hidden="true"><Check /></span>
                      {item}
                    </li>
                  ))
                }
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ─────────── proof, at the point of decision ─────────── -->
  <section class="proof">
    <blockquote class="proof-quote" {...reveal()}>
      <p>&ldquo;{proofQuote.quote}&rdquo;</p>
      <footer>
        <span class="proof-name">{proofQuote.name}</span>
        {proofQuote.context && <span class="proof-context">{proofQuote.context}</span>}
      </footer>
    </blockquote>

    <p class="proof-meta" {...reveal(120)}>
      <strong>200+</strong> mothers prepared · <a class="link-cta" href="/testimonials">Read
      more stories <span class="arrow" aria-hidden="true">→</span></a>
    </p>
  </section>

  <!-- ───────────────────── personalized VIP support ───────────────────── -->
  <section class="vip">
    <div class="vip-panel" {...reveal()}>
      <figure class="vip-media">
        <Image
          src={vipImage}
          alt="Hailey Aliff standing outdoors during pregnancy"
          class="vip-photo"
          style="transform: scale(1.04);"
          data-scroll-scale-image
          widths={[720, 1080, 1440]}
          sizes="(min-width: 1024px) 46vw, 100vw"
        />
      </figure>

      <div class="vip-copy">
        <h2>Joy Within Birth VIP</h2>

        <p class="vip-lede">
          For mamas who want deeper, personalized support, especially those navigating a
          redemption birth or complex history. Priced after a discovery call, so it fits
          what you actually need.
        </p>

        <ul class="vip-list">
          {
            vipFeatures.map((feature) => (
              <li>
                <span class="tick tick-dark" aria-hidden="true"><Check /></span>
                {feature}
              </li>
            ))
          }
        </ul>

        <a class="link-cta vip-link" href={HAILEY_IG} target="_blank" rel="noreferrer">
          Message Hailey about VIP <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── the FAQ ───────────────────────── -->
  <section class="faqs">
    <div class="faq-inner">
      <div class="sec-head" {...reveal()}>
        <p class="eyebrow">Common questions</p>
        <h2>Before you enroll</h2>
      </div>

      <div class="faq-list" {...reveal(120)}>
        <FaqItem question="How do I access the community and course?">
          Everything operates through Skool.com, on your laptop or the free Skool mobile
          app. As soon as your enrollment is confirmed, you'll receive a link to join.
        </FaqItem>
        <FaqItem question="When should I start?">
          Anytime, from preconception through pregnancy. Most mamas enroll between 20 and
          32 weeks, and lifetime access means you can rewatch anything whenever you need
          it, including for future pregnancies.
        </FaqItem>
        <FaqItem question="What if I'm close to my due date?">
          Start with the quick-win modules and lean on the checklists. Even a few focused
          hours can meaningfully shift how prepared and calm you feel walking into labor.
        </FaqItem>
        <FaqItem question="Is this the same as a free hospital class?">
          No. Hospital classes are often built around paperwork and logistics. Joy Within
          Birth is nine full modules covering nutrition, mindset, birth planning,
          postpartum, lactation, the birth partner's role, and holistic fertility, led by
          a second-generation midwife with real lived birth experience.
        </FaqItem>
        <FaqItem question="Will my partner actually use this too?">
          Module 8 was built specifically for partners and support people, so they have a
          clear, defined role rather than standing by unsure of what to do.
        </FaqItem>
        <FaqItem question="Is coaching required to benefit from the course?">
          No. The self-paced course works as a complete, standalone experience. The
          monthly group Q&A and VIP 1:1 coaching are there if and when you want
          additional, personalized support.
        </FaqItem>
      </div>
    </div>
  </section>

  <CtaBand
    capFrom="var(--bg-soft)"
    heading="Ready to trade fear for peace?"
    subheading="Enroll now, and let's gently walk this season together."
    ctaLabel="Enroll Now"
    ctaHref={SKOOL_URL}
  />
</BaseLayout>

<style>
  /* ═══════════════════════════ hero ═══════════════════════════ */
  /* A compact rose wash gives the copy side the same atmosphere as the rest
     of the site while the flat outer ground keeps the photo seam invisible. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(
        48% 60% at 0% 4%,
        rgba(246, 227, 218, 0.92) 0%,
        rgba(246, 227, 218, 0.48) 38%,
        rgba(246, 227, 218, 0) 76%
      ),
      #fcf5f1;
    --curve-h: clamp(34px, 4.6vw, 96px);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    max-width: var(--layout-max);
    margin: 0 auto;
    padding: var(--space-section-md) var(--layout-gutter) var(--space-section-lg);
  }
  .hero-copy {
    width: 50%;
    padding-right: 56px;
  }

  /* The photograph occupies the right half of the hero without creating a
     separate card. A soft mask lets it meet the copy naturally. */
  .hero-media {
    position: absolute;
    z-index: 0;
    inset: 0 0 0 50%;
    margin: 0;
    overflow: hidden;
    border-top-left-radius: clamp(3rem, 9vw, 9rem);
    -webkit-mask-image: linear-gradient(to right, transparent 0, rgba(0, 0, 0, 0.5) 22px, #000 64px);
    mask-image: linear-gradient(to right, transparent 0, rgba(0, 0, 0, 0.5) 22px, #000 64px);
  }
  .hero-media :global(.photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 50%;
    filter: saturate(0.68) contrast(0.94) brightness(1.34);
  }
  .hero-media .grade {
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(105deg, rgba(252, 245, 241, 0.2), transparent 34%);
  }
  .hero-media::before {
    content: '';
    position: absolute;
    z-index: 2;
    inset: 14px;
    border: 1px solid rgba(255, 253, 250, 0.72);
    border-radius: clamp(2.25rem, 8.2vw, 8.25rem) 0 0 0;
    pointer-events: none;
  }
  .hero-media::after {
    content: '';
    position: absolute;
    z-index: 1;
    inset: auto 0 0;
    height: calc(var(--curve-h) * 1.3);
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, rgba(252, 245, 241, 0.82));
  }


  .eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: var(--type-label);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }
  .eyebrow::before {
    content: '';
    width: 40px;
    height: 1px;
    background: var(--border-subtle);
  }

  /* The two beats are broken explicitly in the markup — the offer, then the
     reason — so no ch cap or balancing here. */
  h1 {
    margin-top: 24px;
    font-size: var(--type-display);
    line-height: 1.05;
  }

  .lede {
    margin-top: 24px;
    max-width: 62ch;
    font-size: var(--type-lead);
    line-height: 1.78;
    color: var(--text-muted);
  }

  /* Price with payment context, followed by two side-by-side actions. */
  .offer {
    margin-top: clamp(22px, 3vw, 32px);
  }
  .price-row {
    display: flex;
    align-items: center;
    gap: clamp(12px, 1.4vw, 20px);
  }
  .amount {
    margin: 0;
    flex: none;
    font-size: clamp(2.75rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent-quiet);
  }
  .price-meta {
    margin: 0;
  }
  .price-meta strong {
    display: block;
    font-size: clamp(1.125rem, 2vw, 1.45rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--text-primary);
  }
  .price-meta span {
    display: block;
    margin-top: 0;
    font-size: var(--type-body);
    line-height: 1.4;
    color: var(--text-muted);
  }
  .action-row {
    margin-top: clamp(32px, 4vw, 48px);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: clamp(16px, 2vw, 28px);
    flex-wrap: nowrap;
  }
  .action-row .btn-lg {
    min-width: 12rem;
  }
  .included-link {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-primary);
  }
  .included-link span {
    padding-bottom: 6px;
    background-image: linear-gradient(var(--accent-strong), var(--accent-strong));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 2px;
    transition: color 180ms ease, background-size 180ms ease;
  }
  .included-link :global(svg) {
    width: 21px;
    height: 21px;
    transition: transform 180ms ease;
  }
  .included-link:hover span {
    color: var(--accent-strong);
    background-size: 58% 2px;
  }
  .included-link:hover :global(svg) {
    transform: translateY(3px);
  }

  /* Lives in .included now, centred under the section head. */
  .glance {
    margin: 44px auto 0;
    padding-top: 30px;
    max-width: 52rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 32px 56px;
    text-align: center;
  }
  .glance dt {
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent-quiet);
  }
  .glance dd {
    margin: 8px 0 0;
    font-size: var(--type-label);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ══════════════════════ shared section head ══════════════════════ */
  .wrap {
    max-width: var(--layout-max);
    margin: 0 auto;
    padding: 0 var(--layout-gutter);
  }
  .sec-head {
    max-width: 38em;
    margin: 0 auto;
    text-align: center;
  }
  .sec-head .eyebrow {
    justify-content: center;
  }
  .sec-head .eyebrow::before {
    display: none;
  }
  .sec-head h2 {
    margin-top: 16px;
    font-size: var(--type-section);
    line-height: 1.1;
    text-wrap: balance;
  }

  /* ═══════════════════ what's included, grouped ═══════════════════ */
  .included {
    background: var(--bg-soft);
    padding: var(--space-section-lg) 0 var(--space-section-md);
  }

  .group-grid {
    margin-top: 52px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    max-width: 66rem;
    margin-inline: auto;
  }

  .group {
    padding: 30px 28px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  .group h3 {
    font-size: var(--type-label);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }
  .group ul {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 14px;
  }
  .group li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: var(--type-small);
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .tick {
    display: grid;
    place-items: center;
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    border-radius: 50%;
    background: var(--rose-100);
    color: var(--accent-strong);
  }
  .tick :global(svg) {
    width: 13px;
    height: 13px;
    stroke-width: 3;
  }
  .tick-dark {
    background: rgba(255, 247, 243, 0.14);
    color: var(--rose-200);
  }

  /* ═════════════════════════ the proof ═════════════════════════ */
  .proof {
    background: var(--bg-soft);
    padding: 0 var(--layout-gutter) var(--space-section-lg);
    text-align: center;
  }

  .proof-quote {
    max-width: 44rem;
    margin: 0 auto;
    padding-top: var(--space-section-sm);
    border-top: 1px solid var(--border-subtle);
  }
  .proof-quote p {
    margin: 0;
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    text-wrap: balance;
  }
  .proof-quote footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 14px;
    margin-top: 22px;
  }
  .proof-name {
    font-size: var(--type-label);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }
  .proof-context {
    padding: 5px 13px;
    border: 1px solid var(--rose-300);
    border-radius: var(--radius-pill);
    background: var(--surface);
    font-size: var(--type-label);
    font-weight: 700;
    color: var(--text-secondary);
  }

  .proof-meta {
    margin: 30px auto 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 10px;
    font-size: var(--type-small);
    color: var(--text-muted);
  }
  .proof-meta strong {
    font-weight: 800;
    color: var(--text-primary);
  }

  /* ═════════════════════ personalized VIP support ═════════════════════ */
  /* Full-bleed split feature: the image and dark offer surface are the
     section, rather than a card floating inside another background. */
  .vip {
    background: var(--rose-900);
  }

  .vip-panel {
    --focus-ring: var(--text-inverse);
    display: grid;
    grid-template-columns: minmax(0, 46%) minmax(0, 54%);
    grid-template-areas: 'media copy';
    align-items: stretch;
    width: 100%;
    min-height: clamp(42rem, 62vw, 54rem);
    overflow: hidden;
    background:
      radial-gradient(76% 70% at 100% 0%, rgba(169, 117, 106, 0.28) 0%, rgba(169, 117, 106, 0) 68%),
      linear-gradient(145deg, var(--rose-800) 0%, var(--rose-900) 62%, #2f1c18 100%);
  }

  .vip-copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(56px, 7.4vw, 132px);
  }

  .vip-copy h2 {
    max-width: 10ch;
    font-size: var(--type-display);
    line-height: 1.08;
    color: var(--text-inverse);
  }

  .vip-lede {
    margin-top: 28px;
    max-width: 38em;
    font-size: var(--type-body);
    line-height: 1.78;
    color: rgba(255, 247, 243, 0.76);
  }

  .vip-link {
    align-self: flex-start;
    margin-top: 38px;
    min-height: var(--control-height);
    padding: 0 24px;
    border: 1px solid rgba(255, 247, 243, 0.32);
    border-radius: var(--radius-pill);
    background: rgba(255, 247, 243, 0.04);
    color: var(--text-inverse);
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      transform 220ms ease;
  }
  .vip-link:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 247, 243, 0.58);
    background: rgba(255, 247, 243, 0.1);
  }

  .vip-list {
    margin: 30px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 32px;
    max-width: 44rem;
  }
  .vip-list li {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    font-size: var(--type-small);
    line-height: 1.6;
    color: rgba(255, 247, 243, 0.86);
  }

  .vip-media {
    position: relative;
    grid-area: media;
    min-height: 100%;
    margin: 0;
    overflow: hidden;
  }
  .vip-media::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to left, rgba(63, 38, 32, 0.38), transparent 28%),
      linear-gradient(to top, rgba(47, 28, 24, 0.28), transparent 38%);
    pointer-events: none;
  }
  .vip-media :global(.vip-photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 58%;
    filter: saturate(0.76) contrast(0.94) brightness(0.92);
  }

  /* ═══════════════════════════ the FAQ ═══════════════════════════ */
  .faqs {
    background: var(--bg-soft);
    padding: var(--space-section-lg) 0;
  }
  .faq-inner {
    max-width: 46rem;
    margin: 0 auto;
    padding: 0 var(--layout-gutter);
  }
  .faq-list {
    margin-top: 44px;
    border-top: 1px solid var(--border-subtle);
  }

  /* ═══════════════════════ responsive ═══════════════════════ */
  @media (max-width: 1023px) {
    .hero-grid {
      padding-bottom: var(--space-section-md);
    }
