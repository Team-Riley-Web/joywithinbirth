---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { Image } from 'astro:assets';
import { Users, MessageCircle, Calendar } from '@lucide/astro';

import heroImage from '../assets/images/imgi_7_689ec5431ef51b39e157f9d9.jpg';

import { testimonials } from '../data/testimonials';

const communityStats = [
  { icon: Users, label: '106+ members inside the free community' },
  { icon: MessageCircle, label: 'In-portal messaging with Hailey directly' },
  { icon: Calendar, label: 'Monthly live Q&A calls' },
];
---

<BaseLayout
  title="Testimonials"
  description="Real stories from mamas who walked through fear into calm, confident birth with Joy Within Birth."
>
  <section class="mx-auto max-w-6xl px-6 pb-16 pt-14 sm:pt-20">
    <div class="grid items-center gap-12 md:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-sage-600">Real Stories</p>
        <h1 class="mt-4 text-balance text-4xl leading-[1.1] sm:text-5xl">
          You don't have to wonder if you're the only one who feels this way
        </h1>
        <p class="mt-5 max-w-lg text-lg leading-relaxed text-ink-500">
          The moment a mama joins Joy Within Birth, she realizes she's surrounded by
          women who already understand her. Here are a few of their stories, in their own
          words.
        </p>
      </div>
      <div class="relative aspect-[4/5] overflow-hidden rounded-3xl shadow-lift">
        <Image
          src={heroImage}
          alt="A smiling woman reading a message on her phone"
          class="h-full w-full object-cover"
          style="transform: scale(1.04);"
          data-scroll-scale-image
          widths={[480, 768, 1024]}
          sizes="(min-width: 768px) 45vw, 100vw"
          priority
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((testimonial) => (
        <TestimonialCard testimonial={testimonial} />
      ))}
    </div>
  </section>

  <section class="bg-cream-100 py-16">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-sage-600">The Community</p>
      <h2 class="mt-3 text-balance text-3xl sm:text-4xl">
        A digital classroom and heart-centered community
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-ink-500">
        Joy Within Birth's private community exists for women who want to experience
        pregnancy, birth, and postpartum with confidence, peace, and joy, hosted right
        alongside your course access on Skool.
      </p>
      <div class="mx-auto mt-10 grid max-w-2xl gap-6 sm:grid-cols-3">
        {communityStats.map(({ icon: Icon, label }) => (
          <div class="rounded-2xl bg-cream-50 p-6 shadow-soft ring-1 ring-ink-100/60">
            <Icon class="mx-auto h-6 w-6 text-blush-500" />
            <p class="mt-3 text-sm font-medium text-ink-700">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    heading="Your story could be next"
    subheading="Enroll in Joy Within Birth and join a community of women who already understand exactly what you're carrying."
  />
</BaseLayout>
