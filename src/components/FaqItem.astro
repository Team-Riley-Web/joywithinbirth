---
/**
 * One expandable FAQ row.
 *
 * The trigger is a real <button> carrying aria-expanded, and the panel is tied
 * to it with aria-controls, so the disclosure is announced rather than just
 * looking like one.
 */
import { ChevronDown } from '@lucide/astro';

interface Props {
  question: string;
}

const { question } = Astro.props;

/** Stable id so button and panel can reference each other. */
const panelId = `faq-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="faq" x-data="{ open: false }">
  <button
    type="button"
    class="trigger"
    @click="open = !open"
    :aria-expanded="open"
    aria-controls={panelId}
  >
    <span class="q">{question}</span>
    <span class="chev" aria-hidden="true">
      <ChevronDown x-bind:class="open ? 'rotate-180' : ''" />
    </span>
  </button>

  <div
    id={panelId}
    class="panel"
    x-show="open"
    x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-1"
    x-transition:enter-end="opacity-100 translate-y-0"
  >
    <slot />
  </div>
</div>

<style>
  .faq {
    border-bottom: 1px solid var(--border-subtle);
  }

  .trigger {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    /* min-height carries the tap target; the row would otherwise be ~24px */
    min-height: var(--target-min);
    padding: 18px 0;
    text-align: left;
    cursor: pointer;
  }

  .q {
    font-size: var(--type-body);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.45;
    color: var(--text-primary);
    transition: color 200ms ease;
  }
  .trigger:hover .q {
    color: var(--accent-strong);
  }

  /* A filled disc rather than a bare glyph, so the affordance reads as a control
     at a glance and keeps its own 32px hit area inside the row. */
  .chev {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border: 1px solid var(--border-subtle);
    border-radius: 50%;
    background: var(--bg-soft);
    color: var(--accent-strong);
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }
  .trigger:hover .chev {
    background: var(--rose-100);
    border-color: var(--rose-300);
  }
  .chev :global(svg) {
    width: 18px;
    height: 18px;
    transition: transform 300ms ease;
  }
  .chev :global(.rotate-180) {
    transform: rotate(180deg);
  }

  .panel {
    padding: 0 3.25rem 20px 0;
    font-size: var(--type-small);
    line-height: 1.75;
    color: var(--text-muted);
  }

  @media (max-width: 560px) {
    .panel {
      padding-right: 0;
    }
  }
</style>
