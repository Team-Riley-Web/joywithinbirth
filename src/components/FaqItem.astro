---
import { ChevronDown } from '@lucide/astro';

interface Props {
  question: string;
}

const { question } = Astro.props;
---

<div class="border-b border-ink-100 py-5" x-data="{ open: false }">
  <button
    type="button"
    class="flex w-full items-center justify-between gap-4 text-left"
    @click="open = !open"
    :aria-expanded="open"
  >
    <span class="font-semibold text-ink-900">{question}</span>
    <ChevronDown
      class="h-5 w-5 flex-shrink-0 text-sage-600 transition-transform duration-300"
      x-bind:class="open ? 'rotate-180' : ''"
    />
  </button>
  <div
    x-show="open"
    x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-1"
    x-transition:enter-end="opacity-100 translate-y-0"
    class="pt-3 text-sm leading-relaxed text-ink-500"
  >
    <slot />
  </div>
</div>
