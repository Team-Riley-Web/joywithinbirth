---
import { Menu, X } from '@lucide/astro';
import { Image } from 'astro:assets';
import favicon from '../assets/images/favicon.png';

const navLinks = [
  { href: '/about', label: 'About Hailey' },
  { href: '/course', label: 'The Course' },
  { href: '/testimonials', label: 'Testimonials' },
  { href: '/enroll', label: 'Pricing & FAQ' },
];

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b border-ink-100/70 bg-cream-50/90 backdrop-blur"
  x-data="{ open: false }"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center" aria-label="Joy Within Birth home">
      <Image src={favicon} alt="Joy Within Birth" width={96} height={96} class="h-12 w-12" />
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-sm font-medium transition-colors hover:text-blush-600',
            currentPath === link.href ? 'text-blush-600' : 'text-ink-600',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/enroll"
        class="rounded-full bg-blush-500 px-5 py-2.5 text-sm font-semibold text-cream-50 shadow-soft transition-colors hover:bg-blush-600"
      >
        Enroll Now
      </a>
    </nav>

    <button
      type="button"
      class="text-ink-700 md:hidden"
      aria-label="Toggle menu"
      @click="open = !open"
    >
      <Menu class="h-7 w-7" x-show="!open" />
      <X class="h-7 w-7" x-show="open" x-cloak />
    </button>
  </div>

  <nav
    class="flex flex-col gap-1 border-t border-ink-100/70 bg-cream-50 px-6 py-4 md:hidden"
    x-show="open"
    x-cloak
    x-transition
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class:list={[
          'rounded-lg px-3 py-2.5 text-sm font-medium',
          currentPath === link.href ? 'bg-blush-50 text-blush-600' : 'text-ink-600',
        ]}
      >
        {link.label}
      </a>
    ))}
    <a
      href="/enroll"
      class="mt-2 rounded-full bg-blush-500 px-5 py-3 text-center text-sm font-semibold text-cream-50 shadow-soft"
    >
      Enroll Now
    </a>
  </nav>
</header>
