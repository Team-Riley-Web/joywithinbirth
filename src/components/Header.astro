---
import { Menu, X } from '@lucide/astro';
import { Image } from 'astro:assets';
import favicon from '../assets/images/favicon.png';
import wordmark from '../assets/images/wordmark.png';

const navLinks = [
  { href: '/about', label: 'About Hailey' },
  { href: '/course', label: 'The Course' },
  { href: '/testimonials', label: 'Testimonials' },
  { href: '/enroll', label: 'Pricing' },
];

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b border-beige-300 bg-beige-100/90 backdrop-blur"
  x-data="{ open: false }"
>
  <div class="mx-auto flex max-w-[1320px] items-center justify-between px-6 py-4 lg:px-10">
    <a href="/" class="flex items-center gap-2.5" aria-label="Joy Within Birth home">
      <Image src={favicon} alt="" width={96} height={96} class="h-11 w-11 sm:h-12 sm:w-12" />
      <Image
        src={wordmark}
        alt=""
        class="h-auto w-40 lg:w-[170px]"
        widths={[160, 170, 320, 340]}
        sizes="(min-width: 1024px) 170px, 160px"
      />
    </a>

    <nav class="hidden items-center gap-8 lg:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'inline-flex min-h-11 items-center text-sm font-medium transition-colors hover:text-rose-700',
            currentPath === link.href ? 'text-rose-700' : 'text-ink-600',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/enroll"
        class="btn-grad text-sm"
      >
        Enroll Now
      </a>
    </nav>

    <button
      type="button"
      class="-mr-2 inline-flex h-11 w-11 items-center justify-center text-ink-700 lg:hidden"
      aria-label="Toggle menu"
      :aria-expanded="open"
      @click="open = !open"
    >
      <Menu class="h-7 w-7" x-show="!open" />
      <X class="h-7 w-7" x-show="open" x-cloak />
    </button>
  </div>

  <nav
    class="absolute inset-x-0 top-full flex flex-col gap-1 border-t border-beige-300 bg-beige-100 px-6 py-4 shadow-soft lg:hidden"
    x-show="open"
    x-cloak
    x-transition
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class:list={[
          'flex min-h-11 items-center rounded-lg px-3 text-sm font-medium',
          currentPath === link.href ? 'bg-rose-50 text-rose-700' : 'text-ink-600',
        ]}
      >
        {link.label}
      </a>
    ))}
    <a
      href="/enroll"
      class="btn-grad mt-2 text-sm"
    >
      Enroll Now
    </a>
  </nav>
</header>
