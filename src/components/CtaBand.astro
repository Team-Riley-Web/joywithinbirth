---
/**
 * The closing call to action, sat directly above the footer.
 *
 * This is the one dark moment on an otherwise pale page, and it is doing real
 * work: a page of tints alone reads soft rather than expensive, so the deep
 * rose here is the contrast anchor. Previously a flat sage-green rectangle with
 * hard edges — the green is gone and the ground is now the darkest end of the
 * rose scale, so it anchors without introducing a second hue.
 *
 * Domes up out of the section above via the shared arch cap, same as the rest of
 * the home page, instead of butting against it as a rectangle.
 */
import SectionCurve from './SectionCurve.astro';
import { reveal } from '../lib/reveal';

interface Props {
  heading: string;
  subheading: string;
  ctaLabel?: string;
  ctaHref?: string;
  /** Small print under the buttons. Pass null to omit. */
  meta?: string[] | null;
  /** Ground colour of whatever sits directly above, for the arch cap. */
  capFrom?: string;
}

const {
  heading,
  subheading,
  ctaLabel = 'Enroll Now',
  ctaHref = '/enroll',
  meta = ['One payment', 'Lifetime access', 'Monthly live Q&A'],
  capFrom = 'var(--beige-100)',
} = Astro.props;
---

<section class="cta">
  <SectionCurve from={capFrom} cap />
  <div class="glow" aria-hidden="true"></div>

  <div class="inner">
    <p class="eyebrow" {...reveal()}>Enrollment open</p>
    <h2 {...reveal(110)}>{heading}</h2>
    <p class="sub" {...reveal(200)}>{subheading}</p>

    <div class="actions" {...reveal(290)}>
      <a class="btn-inverse btn-lg" href={ctaHref}>{ctaLabel}</a>
      <a class="btn-line btn-lg" href="/course">See what's included</a>
    </div>

    {
      meta && (
        <ul class="meta" {...reveal(380)}>
          {meta.map((item) => <li>{item}</li>)}
        </ul>
      )
    }
  </div>
</section>

<style>
  .cta {
    /* dark ground: the rose focus ring would vanish here */
    --focus-ring: var(--text-inverse);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(
      to bottom,
      var(--rose-700) 0%,
      var(--rose-800) 42%,
      var(--rose-900) 74%,
      var(--rose-900) 100%
    );
    color: var(--text-inverse);
  }

  /* Warm light falling from the top right, so the panel has some depth rather
     than reading as one flat fill. */
  .glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(64% 70% at 84% 4%, rgba(214, 167, 154, 0.34) 0%, rgba(214, 167, 154, 0) 62%),
      radial-gradient(44% 46% at 10% 56%, rgba(124, 76, 66, 0.32) 0%, rgba(124, 76, 66, 0) 68%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 62%, transparent 88%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 62%, transparent 88%);
    pointer-events: none;
  }

  .inner {
    position: relative;
    max-width: 46rem;
    margin: 0 auto;
    padding: var(--space-section-lg) 32px;
    text-align: center;
  }

  .eyebrow {
    font-size: var(--type-label);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rose-200);
  }

  h2 {
    margin-top: 20px;
    font-size: var(--type-section);
    line-height: 1.08;
    color: var(--text-inverse);
    text-wrap: balance;
  }

  .sub {
    margin: 22px auto 0;
    max-width: 34em;
    font-size: var(--type-lead);
    line-height: 1.78;
    color: rgba(255, 247, 243, 0.78);
    text-wrap: balance;
  }

  .actions {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .meta {
    margin: 42px auto 0;
    padding: 22px 0 0;
    border-top: 1px solid rgba(255, 247, 243, 0.16);
    max-width: 34rem;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 28px;
    font-size: var(--type-label);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 247, 243, 0.66);
  }
  /* separators drawn between items rather than around them */
  .meta li {
    position: relative;
  }
  .meta li + li::before {
    content: '';
    position: absolute;
    left: -15px;
    top: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--rose-300);
    transform: translateY(-50%);
  }

  @media (max-width: 640px) {
    .inner { padding: var(--space-section-md) 24px var(--space-section-sm); }
    .actions { flex-direction: column; align-items: stretch; }
    .meta { gap: 8px 20px; }
    .meta li + li::before { left: -11px; }
  }
</style>
