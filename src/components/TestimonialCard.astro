---
import { Quote } from '@lucide/astro';
import type { Testimonial } from '../data/testimonials';

interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;
---

<figure
  class="flex h-full flex-col rounded-3xl bg-beige-50 p-8 shadow-soft ring-1 ring-rose-200"
>
  <Quote class="h-6 w-6 shrink-0 text-rose-300" />
  <blockquote class="mt-4 flex-1 text-[15px] leading-relaxed text-ink-600">
    &ldquo;{testimonial.quote}&rdquo;
  </blockquote>
  <figcaption class="mt-6 border-t border-rose-200 pt-4 text-sm font-bold text-ink-900">
    {testimonial.name}
  </figcaption>
</figure>
