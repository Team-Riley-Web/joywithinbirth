---
import { Quote } from '@lucide/astro';
import type { Testimonial } from '../data/testimonials';

interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;
---

<figure class="flex h-full flex-col rounded-2xl bg-cream-50 p-7 shadow-soft ring-1 ring-ink-100/60">
  <Quote class="h-6 w-6 text-blush-300" />
  <blockquote class="mt-4 flex-1 text-[15px] leading-relaxed text-ink-600">
    &ldquo;{testimonial.quote}&rdquo;
  </blockquote>
  <figcaption class="mt-5 text-sm font-semibold text-ink-800">
    &mdash; {testimonial.name}
  </figcaption>
</figure>
