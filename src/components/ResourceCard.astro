---
/**
 * One free download or digital guide on /resources.
 *
 * The cover is the visual anchor — a square frame, cropped to keep whatever
 * matters most in the photo in view (see `coverPosition` on the data). These
 * are the same six photos the homepage's "Free resources" carousel uses for
 * the same six opt-ins (see index.astro), already graded to the site's warm,
 * slightly desaturated tone — the same filter + inset rule the photo grid on
 * /testimonials uses (`.gallery-card`) is applied here too, so a cover picked
 * up from a different part of the site still settles into this card cleanly.
 */
import { Image } from 'astro:assets';
import type { Resource } from '../data/resources';

interface Props {
  resource: Resource;
  /** "Quick training" vs "Full guide" — the two sections read alike at a
   * glance otherwise, so each card restates which one it is. */
  kind?: string;
}

const { resource, kind } = Astro.props;
const { title, description, href, ctaLabel, cover, coverAlt, coverPosition = '50% 50%' } = resource;
---

<article class="resource">
  <a class="cover" href={href} target="_blank" rel="noreferrer" tabindex="-1" aria-hidden="true">
    <span class="frame">
      <Image
        src={cover}
        alt={coverAlt}
        class="art"
        style={`object-position: ${coverPosition}; transform: scale(1.04);`}
        data-scroll-scale-image
        widths={[420, 640, 840]}
        sizes="(min-width: 1024px) 420px, (min-width: 640px) 45vw, 90vw"
      />
    </span>
    {kind && <span class="kind">{kind}</span>}
  </a>

  <div class="body">
    <h3><a href={href} target="_blank" rel="noreferrer">{title}</a></h3>
    <p class="desc">{description}</p>
    <a class="btn-quiet" href={href} target="_blank" rel="noreferrer">
      {ctaLabel}
    </a>
  </div>
</article>

<style>
  .resource {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition:
      transform 260ms ease,
      box-shadow 260ms ease,
      border-color 260ms ease;
  }
  .resource:hover {
    transform: translateY(-4px);
    border-color: var(--rose-300);
    box-shadow: var(--shadow-card-hover);
  }

  .cover {
    position: relative;
    display: block;
  }

  .kind {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 1;
    padding: 6px 13px;
    border-radius: var(--radius-pill);
    background: rgba(255, 253, 250, 0.92);
    box-shadow: 0 6px 16px -8px rgba(63, 38, 32, 0.4);
    font-size: var(--type-label);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }

  .frame {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--bg-soft);
  }
  /* The same thin light rule the /testimonials photo grid draws over each
     tile, so these covers read as framed prints rather than raw screenshots. */
  .frame::after {
    content: '';
    position: absolute;
    inset: 9px;
    border: 1px solid rgba(255, 253, 250, 0.6);
    border-radius: calc(var(--radius-sm) - 2px);
    pointer-events: none;
  }

  .art {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Same grading as .gallery-card on /testimonials, so a photo reused from
       elsewhere on the site settles into this card's tone too. */
    filter: saturate(0.8) contrast(1.02) brightness(1.03);
    /* Base scale, matching the homepage's freebie cards — the scroll-scale
       script (see resources.astro) drives this up to 1.2 as the card crosses
       the viewport; the transition smooths its per-frame updates. */
    transition: transform 600ms ease;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 26px 26px 28px;
  }

  .body h3 {
    font-size: var(--type-card);
    font-weight: 800;
    line-height: 1.3;
  }
  .body h3 a {
    color: inherit;
    text-decoration: none;
  }
  .body h3 a:hover {
    color: var(--accent-strong);
  }

  .desc {
    flex: 1;
    margin-top: 10px;
    font-size: var(--type-small);
    line-height: 1.7;
    color: var(--text-muted);
  }

  .body .btn-quiet {
    margin-top: 22px;
    align-self: flex-start;
    font-size: var(--type-small);
    min-height: 2.75rem;
    padding-inline: 1.375rem;
  }
</style>
