---
/**
 * Home hero — Option F.
 *
 * Beige ground with a rose wash, arch-shaped media that fades down into the
 * page rather than stopping at a hard frame, one geometric sans, gradient CTA.
 *
 * Media is the looping clip (`/videos/hero-loop.mp4`) — a 14s cut of Hailey
 * from the course footage, pre-cropped to the arch's own 47:52 so nothing is
 * lost to object-fit and her face stays centred. Falls back to the still
 * photograph automatically if that file is missing.
 */
import fs from 'node:fs';
import path from 'node:path';
import { Image } from 'astro:assets';
import VideoBackdrop from '../VideoBackdrop.astro';
import heroStill from '../../assets/images/hero-arch-crop.jpg';
import fertility from '../../assets/images/imgi_19_689ec90324858a5600fb5a4e.jpg';
import birth from '../../assets/images/imgi_23_68a207374fa1aa2b5b419aef.jpg';
import postpartum from '../../assets/images/imgi_13_689e45cee0fe54b3a73e08c7.jpg';

const heroVideo = '/videos/hero-loop.mp4';
const heroPoster = '/videos/hero-loop.jpg';
const hasVideo = fs.existsSync(path.join(process.cwd(), 'public', heroVideo));
---

<section class="hero">
  <div class="hero-wash" aria-hidden="true"></div>

  <div class="hero-grid">
    <div>
      <p class="eyebrow">Faith-centered natural childbirth</p>

      <h1>
        Prepare for birth with real <span class="signature-accent">joy</span>
      </h1>

      <p class="lede">
        A self-paced training and private community led by Hailey Aliff, a
        second-generation midwife, walking with you from fertility through postpartum.
      </p>

      <div class="cta-row">
        <a class="btn-grad btn-lg" href="/enroll">Enroll once for $350</a>
        <a class="btn-quiet btn-lg" href="/course">View the course</a>
      </div>
    </div>

    <div class="stage">
      <figure class="arch">
        {
          hasVideo ? (
            <VideoBackdrop src={heroVideo} poster={heroPoster} position="50% 50%" class="media" />
          ) : (
            <Image src={heroStill} alt="" class="media" widths={[640, 900, 1280]} sizes="50vw" />
          )
        }
      </figure>

      {/* Nine modules moved up to the small slot... */}
      <div class="chip chip-modules">
        <p class="chip-k">Nine modules</p>
        <p class="chip-v">Ten-plus hours, self-paced</p>
      </div>

      {/* ...so the testimonial takes the prominent lower-right card slot. */}
      <div class="chip chip-proof">
        <div class="avatars">
          <Image src={postpartum} alt="" width={64} height={64} />
          <Image src={birth} alt="" width={64} height={64} />
          <Image src={fertility} alt="" width={64} height={64} />
        </div>
        <p class="chip-n">200+ mothers prepared</p>
        <p class="stars" aria-hidden="true">★★★★★</p>
        <blockquote class="chip-q">
          &ldquo;I went in calm instead of terrified. That changed everything.&rdquo;
        </blockquote>
        <p class="chip-sig">Lifetime access</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #fcf5f1;
  }
  .hero-wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgba(252, 245, 241, 0) 0%, rgba(252, 245, 241, 0) 58%, #fcf5f1 92%, #fcf5f1 100%),
      radial-gradient(86% 78% at 82% 4%, var(--rose-100) 0%, rgba(246, 227, 218, 0) 62%),
      radial-gradient(58% 54% at 98% 58%, rgba(232, 207, 200, 0.8) 0%, rgba(232, 207, 200, 0) 68%);
  }

  /* Wider media column than the earlier pass: the video now gets more room
     than the copy at desktop widths. */
  .hero-grid {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: 64px;
    align-items: center;
    max-width: var(--layout-max);
    margin: 0 auto;
    padding: var(--space-section-sm) var(--layout-gutter) var(--space-section-lg);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: var(--type-label);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }
  .eyebrow::before {
    content: '';
    width: 40px;
    height: 1px;
    background: var(--rose-200);
  }

  h1 {
    font-size: var(--type-display);
    line-height: 1.03;
    margin-top: 24px;
  }
  .lede {
    margin-top: 24px;
    max-width: 32em;
    font-size: var(--type-lead);
    line-height: 1.76;
    color: var(--text-muted);
  }
  .cta-row { margin-top: 34px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }



  /* ---------- arch, faded rather than hard-edged ---------- */
  .stage { position: relative; }
  .arch {
    position: relative;
    margin: 0;
    /* wider and less tall than the earlier pass, to give the video more area */
    aspect-ratio: 47 / 52;
    /* 320 + 320 exceeds the arch's rendered width, so the browser scales the
       two top radii down to meet in the middle — a true semicircle. At 300px
       they stopped short of each other and left a flat segment on top. */
    border-radius: 320px 320px var(--radius-lg) var(--radius-lg);
    overflow: hidden;
  }
  /* Bottom fade only.
     A horizontal fade layer used to live here too, and it was quietly eating
     the arch's entire left shoulder — the dome stayed a clean semicircle but
     half of it was masked away, which read as a flattened top. The arch is a
     deliberate silhouette, so its sides should stay crisp; only the base
     dissolves into the page. */
  .arch :global(.media),
  .arch :global([data-video-backdrop]) {
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 58%,
      rgba(0, 0, 0, 0.72) 80%,
      rgba(0, 0, 0, 0.26) 94%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 58%,
      rgba(0, 0, 0, 0.72) 80%,
      rgba(0, 0, 0, 0.26) 94%,
      transparent 100%
    );
  }

  .arch :global(.media) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 54% 50%;
    filter: saturate(0.9) contrast(1.02) brightness(1.03);
  }

  /* ---------- floating chips ---------- */
  .chip {
    position: absolute;
    background: rgba(255, 253, 250, 0.87);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-float);
  }

  .chip-modules {
    top: 8%;
    left: -44px;
    padding: 14px 22px;
  }
  .chip-k { font-size: 15px; font-weight: 700; letter-spacing: -0.02em; }
  .chip-v { margin-top: 3px; font-size: 12px; color: var(--text-muted); }

  .chip-proof {
    bottom: 7%;
    right: -30px;
    width: 268px;
    padding: 20px 24px;
  }
  .avatars { display: flex; }
  .avatars :global(img) {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--beige-50);
    margin-left: -10px;
  }
  .avatars :global(img:first-child) { margin-left: 0; }
  .chip-n { margin-top: 12px; font-size: 14px; font-weight: 700; letter-spacing: -0.015em; }
  .stars { color: #c9954e; font-size: 11px; letter-spacing: 1.5px; margin-top: 3px; }
  .chip-q {
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .chip-sig {
    margin-top: 13px;
    padding-top: 11px;
    border-top: 1px solid var(--border-subtle);
    font-size: var(--type-label);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }

  @media (max-width: 1023px) {
    .hero-grid { grid-template-columns: 1fr; gap: 44px; }
    .hero-grid > div:first-child { text-align: center; }
    .eyebrow { justify-content: center; }
    .eyebrow::before { display: none; }
    .lede { margin-inline: auto; }
    .cta-row { justify-content: center; }
    /* `margin: 0 auto` here would switch this stretched grid item to
       shrink-to-fit, collapsing the aspect-ratio arch to zero width. */
    .stage { width: 100%; max-width: 480px; justify-self: center; }
    .chip-modules { left: -8px; }
    .chip-proof { right: -8px; width: 250px; }
  }
  @media (max-width: 560px) {
    .chip-modules { display: none; }
    .chip-proof { position: static; width: auto; margin-top: 20px; backdrop-filter: none; }
  }
</style>
