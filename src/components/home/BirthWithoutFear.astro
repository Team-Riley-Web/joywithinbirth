---
/**
 * "Birth without fear" — the misty, feathered section.
 *
 * Carried over from the earlier HomeHeroAlt exploration, restyled onto Option F:
 * geometric sans headline, rose accent, beige ground. The photograph still has
 * no hard frame at all — it is masked on both axes so it dissolves into the
 * page, which is the thing that made this one work.
 *
 * The one script accent on the site is the word "joy" in Lindsey Signature.
 * It survives because it is the signature of this section rather than a
 * decorative italic. To drop it, remove .accent and the <span>.
 */
import { Image } from 'astro:assets';
import SectionCurve from '../SectionCurve.astro';
import { reveal } from '../../lib/reveal';
import heroAlt from '../../assets/images/home-hero-alt.png';
---

<section class="bwf">
  <div class="wash" aria-hidden="true"></div>

  <div class="photo" aria-hidden="true">
    <Image src={heroAlt} alt="" widths={[900, 1280, 1600]} sizes="66vw" />
  </div>

  <!-- Painted over the top of the photo, so the arc clips it instead of the
       photo needing a top fade. `from` must match the previous section. -->
  <SectionCurve from="var(--rose-75)" cap />

  <div class="inner">
    <p class="eyebrow" {...reveal()}>Why mothers choose this</p>

    <h2 {...reveal(110)}>
      Birth without fear,<br />and with real <span class="accent">joy</span>
    </h2>

    <p class="lede" {...reveal(220)}>
      Fear is what turns a manageable labor into a frightening one. The training
      replaces it with something sturdier: knowing what is happening in your body,
      what your options are, and who is beside you.
    </p>

    <dl class="stats" {...reveal(330)}>
      <div>
        <dt>200+</dt>
        <dd>Mothers supported</dd>
      </div>
      <div>
        <dt>9</dt>
        <dd>Modules</dd>
      </div>
      <div>
        <dt>10+</dt>
        <dd>Hours self-paced</dd>
      </div>
      <div>
        <dt>Lifetime</dt>
        <dd>Access</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .bwf {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--beige-100);
  }

  .wash {
    position: absolute;
    inset: 0;
    z-index: -4;
    background: radial-gradient(
      116% 88% at 74% 14%,
      var(--rose-100) 0%,
      var(--rose-50) 38%,
      var(--beige-100) 62%,
      var(--beige-100) 100%
    );
  }

  /* No frame on any side: the photograph is masked so it fades out toward the
     copy and along the bottom. */
  .photo {
    position: absolute;
    inset-block: 0;
    right: 0;
    width: 66%;
    z-index: -3;
    overflow: hidden;
    -webkit-mask-image:
      linear-gradient(
        to right,
        transparent 0%,
        transparent 26%,
        rgba(0, 0, 0, 0.28) 40%,
        rgba(0, 0, 0, 0.78) 58%,
        #000 76%
      ),
      linear-gradient(to bottom, #000 0%, #000 74%, rgba(0, 0, 0, 0.4) 92%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(
        to right,
        transparent 0%,
        transparent 26%,
        rgba(0, 0, 0, 0.28) 40%,
        rgba(0, 0, 0, 0.78) 58%,
        #000 76%
      ),
      /* also fade the bottom, or the photo ends on a hard line where the
         section does */
      linear-gradient(to bottom, #000 0%, #000 74%, rgba(0, 0, 0, 0.4) 92%, transparent 100%);
    mask-composite: intersect;
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 28%;
    filter: saturate(1.06) contrast(1.14);
  }


  .inner {
    position: relative;
    max-width: 1320px;
    margin: 0 auto;
    padding: 104px 40px 116px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rose-600);
  }
  .eyebrow::before {
    content: '';
    width: 46px;
    height: 1px;
    background: var(--rose-200);
  }

  h2 {
    margin-top: 26px;
    font-size: clamp(2.6rem, 5vw, 4.6rem);
    line-height: 1.04;
    max-width: 18em;
  }
  .accent {
    font-family: "Lindsey Signature", cursive;
    font-weight: 400;
    font-size: 1.16em;
    line-height: 0.8;
    letter-spacing: 0;
    color: var(--rose-500);
    margin-left: 8px;
  }

  .lede {
    margin-top: 28px;
    max-width: 34em;
    font-size: 17px;
    line-height: 1.82;
    color: var(--f-ink-soft);
  }

  .stats {
    margin-top: 56px;
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    border-top: 1px solid var(--rose-200);
    padding-top: 28px;
    max-width: 760px;
  }
  .stats dt {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--rose-500);
  }
  .stats dd {
    margin-top: 8px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--f-ink-soft);
  }

  @media (max-width: 900px) {
    .photo {
      inset-block: auto 0;
      width: 100%;
      height: 46%;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.6) 30%, #000 62%);
      mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.6) 30%, #000 62%);
    }
    .inner { padding: 64px 24px 300px; }
    .stats { gap: 32px; margin-top: 40px; }
  }
</style>
