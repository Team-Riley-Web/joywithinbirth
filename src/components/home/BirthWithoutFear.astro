---
/**
 * "Birth without fear" — the misty, feathered section.
 *
 * Carried over from the earlier HomeHeroAlt exploration, restyled onto Option F:
 * geometric sans headline and beige ground. The photograph still has
 * no hard frame at all — it is masked on both axes so it dissolves into the
 * page, which is the thing that made this one work.
 *
 */
import { Image } from 'astro:assets';
import { reveal } from '../../lib/reveal';
import SectionCurve from '../SectionCurve.astro';
import heroAlt from '../../assets/images/home-hero-alt.png';
---

<section class="bwf">
  <div class="wash" aria-hidden="true"></div>

  <div class="photo" aria-hidden="true">
    <Image src={heroAlt} alt="" widths={[900, 1280, 1600]} sizes="(min-width: 1024px) 66vw, 100vw" />
  </div>

  <div class="inner">
    <p class="eyebrow" {...reveal()}>Why mothers choose this</p>

    <h2 {...reveal(110)}>
      Birth prepared,<br />not afraid
    </h2>

    <p class="lede" {...reveal(220)}>
      Fear is what turns a manageable labor into a frightening one. The training
      replaces it with something sturdier: knowing what is happening in your body,
      what your options are, and who is beside you.
    </p>

    <a class="btn-grad btn-lg btn-bwf" href="/enroll" {...reveal(280)}>Enroll Now</a>

    <dl class="stats" {...reveal(330)}>
      <div>
        <dt>200+</dt>
        <dd>Mothers <span>supported</span></dd>
      </div>
      <div>
        <dt>9</dt>
        <dd>Modules</dd>
      </div>
      <div>
        <dt>10+</dt>
        <dd>Hours <span>self-paced</span></dd>
      </div>
      <div>
        <dt class="stat-lifetime">Lifetime</dt>
        <dd>Access</dd>
      </div>
    </dl>
  </div>

  <SectionCurve from="transparent" to="var(--rose-50)" overlay />
</section>

<style>
  .bwf {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--beige-100);
  }

  .wash {
    position: absolute;
    inset: 0;
    z-index: -4;
    background: radial-gradient(
      116% 88% at 74% 14%,
      var(--rose-100) 0%,
      var(--rose-50) 38%,
      var(--beige-100) 62%,
      var(--beige-100) 100%
    );
  }

  /* No frame on any side: the photograph is masked so it fades out toward the
     copy and along the bottom. */
  .photo {
    position: absolute;
    inset-block: 0;
    right: 0;
    width: 66%;
    z-index: -3;
    overflow: hidden;
    -webkit-mask-image:
      linear-gradient(
        to right,
        transparent 0%,
        transparent 26%,
        rgba(0, 0, 0, 0.28) 40%,
        rgba(0, 0, 0, 0.78) 58%,
        #000 76%
      ),
      linear-gradient(to bottom, #000 0%, #000 74%, rgba(0, 0, 0, 0.4) 92%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(
        to right,
        transparent 0%,
        transparent 26%,
        rgba(0, 0, 0, 0.28) 40%,
        rgba(0, 0, 0, 0.78) 58%,
        #000 76%
      ),
      /* also fade the bottom, or the photo ends on a hard line where the
         section does */
      linear-gradient(to bottom, #000 0%, #000 74%, rgba(0, 0, 0, 0.4) 92%, transparent 100%);
    mask-composite: intersect;
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 28%;
    filter: saturate(1.06) contrast(1.14);
  }


  .inner {
    position: relative;
    max-width: var(--layout-max);
    margin: 0 auto;
    padding: var(--space-section-lg) var(--layout-gutter) calc(var(--space-section-lg) + 1rem);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: var(--type-label);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }
  .eyebrow::before {
    content: '';
    width: 46px;
    height: 1px;
    background: var(--rose-200);
  }

  h2 {
    margin-top: 26px;
    font-size: var(--type-display);
    line-height: 1.04;
    max-width: 18em;
  }
  .lede {
    margin-top: 28px;
    max-width: 34em;
    font-size: var(--type-lead);
    line-height: 1.82;
    color: var(--text-muted);
  }

  .btn-bwf {
    margin-top: 42px;
  }

  .stats {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    border-top: 1px solid var(--border-subtle);
    padding-top: 28px;
    max-width: 760px;
  }
  .stats dt {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--accent-quiet);
  }
  .stats dd {
    margin-top: 8px;
    font-size: var(--type-label);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  @media (max-width: 1023px) {
    .photo {
      inset-block: auto 0;
      width: 100%;
      height: 46%;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.6) 30%, #000 62%);
      mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.6) 30%, #000 62%);
    }
    .inner { padding: var(--space-section-md) var(--layout-gutter) 300px; text-align: center; }
    .eyebrow { justify-content: center; }
    .eyebrow::before { display: none; }
    .lede { margin-inline: auto; }
    .stats { justify-content: center; gap: 32px; margin: 40px auto 0; }
    .photo :global(img) {
      object-position: 68% 68%;
      transform: scale(1.18);
    }
  }

  @media (max-width: 600px) {
    .stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
    }
    .stats > div { min-width: 0; }
    .stats dt { font-size: clamp(1.35rem, 7vw, 1.875rem); }
    .stats .stat-lifetime { font-size: clamp(1rem, 5.2vw, 1.35rem); }
    .stats dd {
      font-size: 10px;
      letter-spacing: 0.1em;
      line-height: 1.5;
    }
    .stats dd span { display: block; }
  }
</style>
