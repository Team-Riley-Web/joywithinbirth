---
/**
 * Testimonials that drift continuously in an infinite loop.
 */
import TestimonialCard from '../TestimonialCard.astro';
import { Image } from 'astro:assets';
import { reveal } from '../../lib/reveal';
import { testimonials } from '../../data/testimonials';
import footElement from '../../assets/images/elements/7.png';

const firstTestimonial = testimonials[0]!;
const lastTestimonial = testimonials[testimonials.length - 1]!;
---

<section class="stories">
  <Image src={footElement} alt="" aria-hidden="true" class="foot-ghost" />

  <div class="wrap">
    <div class="head" {...reveal()}>
      <div>
        <p class="eyebrow">Real stories</p>
        <h2>Mamas who walked this road before you</h2>
      </div>

      <a class="more more-head link-cta" href="/testimonials">Read more stories</a>
    </div>
  </div>

  <div class="viewport" {...reveal(120)}>
    <div class="track" tabindex="0" aria-label="Testimonials">
      <ul class="lane">
        {
          testimonials.map((testimonial) => (
            <li class="slide">
              <TestimonialCard testimonial={testimonial} />
            </li>
          ))
        }
      </ul>

      <ul class="lane" aria-hidden="true">
        {
          testimonials.map((testimonial) => (
            <li class="slide">
              <TestimonialCard testimonial={testimonial} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div
    class="mobile-carousel"
    aria-label="Testimonials"
    x-data={`{
      active: 0,
      position: 1,
      total: ${testimonials.length},
      timer: null,
      transitionTimer: null,
      transitioning: true,
      locked: false,
      duration: 1100,
      reducedMotion: false,
      init() {
        this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (this.reducedMotion) this.duration = 0;
        this.start();
      },
      start() {
        this.stop();
        if (this.reducedMotion || this.total < 2) return;
        this.timer = window.setInterval(() => this.move(1, false), 5000);
      },
      stop() {
        if (this.timer) window.clearInterval(this.timer);
        this.timer = null;
      },
      move(direction, restart = true) {
        if (this.locked || this.total < 2) return;

        this.locked = true;
        this.active = (this.active + direction + this.total) % this.total;
        this.position += direction;
        if (restart) this.start();

        if (this.transitionTimer) window.clearTimeout(this.transitionTimer);
        this.transitionTimer = window.setTimeout(() => {
          if (this.position === 0) this.jumpTo(this.total);
          else if (this.position === this.total + 1) this.jumpTo(1);
          else this.locked = false;
        }, this.duration);
      },
      jumpTo(position) {
        this.transitioning = false;
        this.position = position;
        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => {
            this.transitioning = true;
            this.locked = false;
          });
        });
      },
      destroy() {
        this.stop();
        if (this.transitionTimer) window.clearTimeout(this.transitionTimer);
      }
    }`}
  >
    <div class="mobile-viewport">
      <ul
        class="mobile-track"
        :class="{ 'is-jumping': !transitioning }"
        :style="'transform: translateX(-' + (position * 100) + '%)'"
      >
        <li class="mobile-slide" aria-hidden="true">
          <TestimonialCard testimonial={lastTestimonial} />
        </li>

        {
          testimonials.map((testimonial, i) => (
            <li class="mobile-slide" :aria-hidden={`active !== ${i}`}>
              <TestimonialCard testimonial={testimonial} />
            </li>
          ))
        }

        <li class="mobile-slide" aria-hidden="true">
          <TestimonialCard testimonial={firstTestimonial} />
        </li>
      </ul>
    </div>

    <a class="more mobile-more link-cta" href="/testimonials">Read more stories</a>
  </div>
</section>

<style>
  .stories {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--bg-page);
    padding: var(--space-section-lg) 0;
  }
  .stories :global(.foot-ghost) {
    position: absolute;
    right: max(26px, calc((100vw - var(--layout-max)) / 2 + 190px));
    top: 18px;
    z-index: -1;
    width: clamp(130px, 14vw, 205px);
    opacity: 0.045;
    mix-blend-mode: multiply;
    pointer-events: none;
    user-select: none;
  }
  .wrap { max-width: var(--layout-max); margin: 0 auto; padding: 0 var(--layout-gutter); }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }
  .eyebrow {
    font-size: var(--type-label);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }
  .head h2 {
    margin-top: 14px;
    font-size: var(--type-section);
    line-height: 1.1;
    max-width: 18ch;
  }

  .viewport {
    margin-top: 44px;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0, #000 9%, #000 91%, transparent 100%);
  }
  .track {
    display: flex;
    width: max-content;
    gap: 24px;
    padding: 4px 0;
    animation: testimonial-marquee 110s linear infinite;
  }
  .viewport:hover .track,
  .track:focus-within { animation-play-state: paused; }
  .track:focus-visible { outline: 3px solid var(--focus-ring); outline-offset: 4px; }

  .lane {
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .slide {
    flex: 0 0 auto;
    width: min(390px, 82vw);
  }

  /* Phones use a discrete carousel; tablet and desktop keep the marquee. */
  .mobile-carousel {
    display: none;
  }
  .mobile-viewport {
    overflow: hidden;
    width: 100%;
  }
  .mobile-track {
    display: flex;
    margin: 0;
    padding: 4px 0 2px;
    list-style: none;
    transform: translateX(-100%);
    transition: transform 1100ms cubic-bezier(0.22, 0.65, 0.3, 1);
    will-change: transform;
  }
  .mobile-track.is-jumping {
    transition: none;
  }
  .mobile-slide {
    flex: 0 0 100%;
    min-width: 0;
  }
  .mobile-more {
    display: none;
  }

  .more {
    flex: none;
  }

  @keyframes testimonial-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50% - 12px)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .viewport {
      overflow-x: auto;
      mask-image: none;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .viewport::-webkit-scrollbar { display: none; }
    .track { animation: none; }
    .mobile-track { transition: none; }
  }

  @media (max-width: 1023px) {
    .stories :global(.foot-ghost) {
      right: 14px;
      top: 40px;
      width: 112px;
    }
    .head { flex-direction: column; align-items: center; gap: 20px; text-align: center; }
    .head h2 { max-width: none; }
    .more-head { align-self: center; }
  }

  @media (max-width: 639px) {
    .stories {
      padding-top: 6.5rem;
    }
    .stories :global(.foot-ghost) {
      top: 10px;
      right: auto;
      left: 50%;
      width: 72px;
      opacity: 0.085;
      transform: translateX(-50%);
    }
    .viewport {
      display: none;
    }
    .more-head {
      display: none;
    }
    .mobile-carousel {
      display: flex;
      flex-direction: column;
      align-items: center;
      max-width: 32rem;
      width: calc(100% - var(--layout-gutter) - var(--layout-gutter));
      margin: 44px auto 0;
    }
    .mobile-slide :global(.card) {
      box-shadow: none;
    }
    .mobile-slide :global(.card:hover) {
      transform: none;
      box-shadow: none;
    }
    .mobile-more {
      display: inline-flex;
      margin-top: 22px;
    }
  }
</style>
