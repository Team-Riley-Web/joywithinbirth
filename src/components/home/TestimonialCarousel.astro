---
/**
 * Testimonials that drift continuously in an infinite loop.
 */
import TestimonialCard from '../TestimonialCard.astro';
import { Image } from 'astro:assets';
import { reveal } from '../../lib/reveal';
import { testimonials } from '../../data/testimonials';
import footElement from '../../assets/images/elements/7.png';
---

<section class="stories">
  <Image src={footElement} alt="" aria-hidden="true" class="foot-ghost" />

  <div class="wrap">
    <div class="head" {...reveal()}>
      <div>
        <p class="eyebrow">Real stories</p>
        <h2>Mamas who walked this road before you</h2>
      </div>

      <a class="more more-head" href="/testimonials">Read more stories</a>
    </div>
  </div>

  <div class="viewport" {...reveal(120)}>
    <div class="track" tabindex="0" aria-label="Testimonials">
      <ul class="lane">
        {
          testimonials.map((testimonial) => (
            <li class="slide">
              <TestimonialCard testimonial={testimonial} />
            </li>
          ))
        }
      </ul>

      <ul class="lane" aria-hidden="true">
        {
          testimonials.map((testimonial) => (
            <li class="slide">
              <TestimonialCard testimonial={testimonial} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .stories {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--beige-100);
    padding: 96px 0 108px;
  }
  .stories :global(.foot-ghost) {
    position: absolute;
    right: max(-70px, calc((100vw - var(--f-max)) / 2 - 44px));
    bottom: 24px;
    z-index: -1;
    width: clamp(210px, 25vw, 360px);
    opacity: 0.045;
    mix-blend-mode: multiply;
    pointer-events: none;
    user-select: none;
  }
  .wrap { max-width: var(--f-max); margin: 0 auto; padding: 0 40px; }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }
  .eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rose-600);
  }
  .head h2 {
    margin-top: 14px;
    font-size: clamp(1.9rem, 3.3vw, 2.9rem);
    line-height: 1.1;
    max-width: 18ch;
  }

  .viewport {
    margin-top: 44px;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0, #000 9%, #000 91%, transparent 100%);
  }
  .track {
    display: flex;
    width: max-content;
    gap: 24px;
    padding: 4px 0;
    animation: testimonial-marquee 110s linear infinite;
  }
  .viewport:hover .track,
  .track:focus-within { animation-play-state: paused; }
  .track:focus-visible { outline: 2px solid var(--rose-400); outline-offset: 4px; }

  .lane {
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .slide {
    flex: 0 0 auto;
    width: min(390px, 82vw);
  }

  .more {
    flex: none;
    font-size: 14px;
    font-weight: 700;
    color: var(--rose-600);
    text-decoration: none;
    border-bottom: 1px solid var(--rose-200);
    padding-bottom: 4px;
  }

  @keyframes testimonial-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50% - 12px)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .viewport {
      overflow-x: auto;
      mask-image: none;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .viewport::-webkit-scrollbar { display: none; }
    .track { animation: none; }
  }

  @media (max-width: 900px) {
    .stories { padding: 68px 0 80px; }
    .wrap { padding: 0 24px; }
    .head { flex-direction: column; align-items: flex-start; gap: 20px; }
    .head h2 { max-width: none; }
    .more-head { align-self: flex-start; }
  }
</style>
