---
/**
 * The problem statement, immediately after the hero.
 *
 * Begins on the hero's beige ground and fades into the rose ground below, so
 * the section arrives as a gradual movement rather than a hard curve.
 */
import { Image } from 'astro:assets';
import { reveal } from '../../lib/reveal';
import element1 from '../../assets/images/elements/1.png';
---

<section class="problem">
  <div class="ghost ghost-left" aria-hidden="true">
    <Image src={element1} alt="" widths={[360, 560, 720]} sizes="24vw" />
  </div>

  <div class="wrap">
    <h2 {...reveal()}>You don't have to piece this together alone</h2>

    <p class="body" {...reveal(120)}>
      So many tabs open. So many conflicting opinions from hospital classes, social
      media, and well-meaning family.
    </p>

    <p class="question" {...reveal(240)}>
      And still, that quiet question:<br />
      <strong>Will I actually be ready when the moment comes?</strong>
    </p>

    <p class="answer" {...reveal(360)}>
      Joy Within Birth gathers everything scattered across the internet into one
      trusted, faith-centered place.
    </p>

    <a class="btn-grad btn-problem" href="/course" {...reveal(460)}>See what's inside the course</a>
  </div>
</section>

<style>
  .problem {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(
      to bottom,
      #fcf5f1 0%,
      var(--rose-50) 34%,
      var(--rose-50) 100%
    );
    padding: 116px 0 124px;
  }

  .ghost {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    user-select: none;
  }
  .ghost-left {
    //top: 38px;
    left: max(24px, calc((100vw - 1320px) / 2 + 10px));
    width: clamp(165px, 16vw, 335px);
    opacity: 0.4;
  }
  .ghost :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .wrap {
    position: relative;
    z-index: 1;
    max-width: 54rem;
    margin: 0 auto;
    padding: 0 32px;
    text-align: center;
  }

  h2 {
    font-size: clamp(2.1rem, 4.2vw, 3.4rem);
    line-height: 1.08;
    text-wrap: balance;
  }

  .body {
    margin: 30px auto 0;
    max-width: 34em;
    font-size: 17.5px;
    line-height: 1.8;
    color: var(--f-ink-soft);
    text-wrap: balance;
  }

  /* The pivot. Given its own size, colour and air so it lands as the thought the
     reader is already having, instead of an aside inside a paragraph. */
  .question {
    margin: 26px auto 0;
    max-width: 22em;
    font-size: clamp(1.25rem, 2.1vw, 1.6rem);
    line-height: 1.45;
    color: var(--rose-600);
    text-wrap: balance;
  }
  .question strong {
    display: block;
    margin-top: 6px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--rose-700);
  }

  .answer {
    margin: 26px auto 0;
    max-width: 32em;
    font-size: 17px;
    line-height: 1.8;
    color: var(--f-ink-soft);
    text-wrap: balance;
  }

  .btn-problem {
    margin-top: 40px;
    padding: 16px 34px;
  }

  @media (max-width: 720px) {
    .problem { padding: 76px 0 84px; }
    .ghost { display: none; }
    .wrap { padding: 0 24px; }
    .body, .question, .answer { margin-top: 26px; }
    .question { margin-top: 26px; }
  }
</style>
