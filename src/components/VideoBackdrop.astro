---
/**
 * Ambient background video. Fills its positioned parent.
 *
 * Built for short, low-motion loops used as texture behind content, not for
 * video the user is meant to watch. There are no controls and no audio track is
 * ever unmuted, which is also what lets it autoplay in every browser.
 *
 * Two triggers:
 *   'auto'  — plays whenever it is on screen, pauses when scrolled away.
 *   'hover' — stays on its poster until the user hovers (or keyboard-focuses)
 *             the nearest [data-hover-play] ancestor. On touch devices, where
 *             hover does not exist, it plays while visible instead.
 *
 * Users with `prefers-reduced-motion: reduce` never load or play the video —
 * they get the poster still. The poster also paints immediately, so there is no
 * empty box while the video buffers.
 */
interface Props {
  /** Path under /public, e.g. "/videos/journey-birth.mp4" */
  src: string;
  /** Poster still, framed to match the clip */
  poster: string;
  /** CSS object-position, e.g. "50% 40%" */
  position?: string;
  /** 'auto' plays on screen; 'hover' waits for the nearest [data-hover-play] */
  trigger?: 'auto' | 'hover';
  /** Extra classes on the <video> */
  class?: string;
  /** Decorative by default; pass a description if it carries meaning */
  label?: string;
}

const {
  src,
  poster,
  position = '50% 50%',
  trigger = 'auto',
  class: className = '',
  label,
} = Astro.props;
---

<div class="backdrop" data-video-backdrop data-trigger={trigger}>
  <img src={poster} alt={label ?? ''} aria-hidden={label ? undefined : 'true'} class="poster" />
  <video
    class:list={['video', className]}
    src={src}
    poster={poster}
    muted
    loop
    playsinline
    preload={trigger === 'hover' ? 'none' : 'metadata'}
    aria-hidden="true"
    tabindex="-1"
  ></video>
</div>

<style define:vars={{ position }}>
  .backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .poster,
  .video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--position);
  }

  /* The video fades in over the poster once it has real frames, so a slow
     connection degrades to a still image rather than a flash of empty box. */
  .video {
    opacity: 0;
    transition: opacity 450ms ease;
  }
  .video[data-visible] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .video {
      display: none;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-video-backdrop]').forEach((wrap) => {
    const video = wrap.querySelector('video');
    if (!video || prefersReducedMotion) return;

    const reveal = () => video.setAttribute('data-visible', '');
    const conceal = () => video.removeAttribute('data-visible');

    const play = () => {
      video.play().then(reveal).catch(() => {
        // Autoplay refused (rare when muted). The poster stays visible.
      });
    };

    const supportsHover =
      window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
      !window.matchMedia('(max-width: 560px)').matches;

    if (wrap.dataset.trigger === 'hover' && supportsHover) {
      // Bind to the card, not the video, so hovering anywhere on it counts.
      const target = wrap.closest<HTMLElement>('[data-hover-play]') ?? wrap;
      let leaveTimer: number | undefined;

      const enter = () => {
        window.clearTimeout(leaveTimer);
        play();
      };

      const leave = () => {
        conceal();
        // Let the fade finish before pausing, or the last frame snaps back
        // to the poster mid-transition.
        leaveTimer = window.setTimeout(() => {
          video.pause();
          video.currentTime = 0;
        }, 450);
      };

      target.addEventListener('pointerenter', enter);
      target.addEventListener('pointerleave', leave);
      // Keyboard parity: focusing a link inside the card plays it too.
      target.addEventListener('focusin', enter);
      target.addEventListener('focusout', leave);
      return;
    }

    // trigger: 'auto', plus hover-triggered media on touch devices — play while
    // on screen and pause when it is not, so off-screen video stops decoding.
    video.addEventListener('canplay', reveal, { once: true });

    new IntersectionObserver(
      ([entry]) => (entry.isIntersecting ? play() : video.pause()),
      { threshold: 0.05 },
    ).observe(wrap);
  });
</script>
