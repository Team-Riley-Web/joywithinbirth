---
import { Heart, Users } from '@lucide/astro';
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';

const exploreLinks = [
  { href: '/about', label: 'About Hailey' },
  { href: '/course', label: 'The Course' },
  { href: '/testimonials', label: 'Testimonials' },
  { href: '/enroll', label: 'Pricing & FAQ' },
];

const socialLinks = [
  { href: 'https://www.facebook.com/joywithinbirth/', label: 'Facebook' },
  { href: 'https://www.instagram.com/haileyaliff/', label: 'Instagram' },
  { href: 'https://www.youtube.com/@joywithinbirth', label: 'YouTube' },
];

const communityLink = { href: 'https://www.skool.com/joywithinbirth/about', label: 'Community' };
---

<footer class="bg-gradient-to-b from-rose-900 via-rose-900 to-[#241411]">
  <div class="mx-auto max-w-6xl px-6 pb-10 pt-8 sm:py-14">
    <div class="grid grid-cols-2 gap-x-8 gap-y-8 text-center lg:grid-cols-[1.4fr_1fr_1fr] lg:text-left">
      <div class="col-span-2 flex justify-center lg:col-span-1 lg:justify-start">
        <a href="/" class="inline-block">
          <Image src={logo} alt="Joy Within Birth" width={400} height={355} class="h-auto w-[170px] brightness-0 invert sm:w-[200px]" />
        </a>
      </div>

      <div>
        <p class="text-sm font-semibold text-beige-50">Explore</p>
        <ul class="mt-4 space-y-3">
          {exploreLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-beige-50/62 transition-colors hover:text-rose-200">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold text-beige-50">Connect</p>
        <ul class="mt-4 flex items-center justify-center gap-3 lg:justify-start">
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noreferrer"
                class="flex h-10 w-10 items-center justify-center rounded-full bg-beige-50/10 text-rose-100 shadow-soft ring-1 ring-beige-50/14 transition duration-500 ease-out hover:-translate-y-0.5 hover:bg-beige-50 hover:text-rose-800 hover:shadow-lift"
                aria-label={link.label}
              >
                {
                  link.label === 'Facebook' ? (
                    <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
                      <path d="M14.4 8.1h2.3V4.4c-.4-.1-1.8-.2-3.4-.2-3.3 0-5.5 2-5.5 5.7v3.2H4.2v4.1h3.6V24h4.4v-6.8h3.6l.6-4.1h-4.2V10.3c0-1.2.3-2.2 2.2-2.2Z" />
                    </svg>
                  ) : link.label === 'Instagram' ? (
                    <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
                      <path d="M7.3 2h9.4A5.3 5.3 0 0 1 22 7.3v9.4a5.3 5.3 0 0 1-5.3 5.3H7.3A5.3 5.3 0 0 1 2 16.7V7.3A5.3 5.3 0 0 1 7.3 2Zm0 2A3.3 3.3 0 0 0 4 7.3v9.4A3.3 3.3 0 0 0 7.3 20h9.4a3.3 3.3 0 0 0 3.3-3.3V7.3A3.3 3.3 0 0 0 16.7 4H7.3ZM12 7.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8Zm0 2a2.9 2.9 0 1 0 0 5.8 2.9 2.9 0 0 0 0-5.8Zm5.1-2.3a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2Z" />
                    </svg>
                  ) : (
                    <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
                      <path d="M21.6 7.2a2.6 2.6 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.6 2.6 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.6 2.6 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.6 2.6 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8ZM10 15.1V8.9l5.3 3.1-5.3 3.1Z" />
                    </svg>
                  )
                }
              </a>
            </li>
          ))}
        </ul>
        <a
          href={communityLink.href}
          target="_blank"
          rel="noreferrer"
          class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-beige-50/68 transition-colors hover:text-rose-200"
        >
          <Users class="h-4 w-4 text-rose-200" />
          {communityLink.label}
        </a>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col items-center gap-2 border-t border-beige-50/12 pt-6 text-center text-xs text-beige-50/46 sm:mt-12 lg:flex-row lg:justify-between lg:text-left"
    >
      <p>&copy; {new Date().getFullYear()} Joy Within Birth LLC. All rights reserved.</p>
      <span class="flex items-center justify-center gap-1 text-beige-50/46">
        Made with <Heart class="h-3 w-3 fill-rose-300 text-rose-300" /> by
        <a
          href="https://teamrileyweb.com"
          target="_blank"
          rel="noreferrer"
          class="transition-colors hover:text-rose-200"
        >
          Team Riley
        </a>
      </span>
    </div>
  </div>
</footer>
