---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /* Overrides the headline on social cards, which otherwise mirrors <title>.
     Useful where the tab title is a terse nav label ("Home") that reads oddly
     as the first line of a shared link. */
  ogTitle?: string;
  /* Root-relative path to a page-specific share image. Falls back to the
     sitewide card. */
  image?: string;
  imageAlt?: string;
  /* og:type — 'article' for anything dated or authored. */
  type?: string;
}

const { title, description, ogTitle, image, imageAlt, type = 'website' } = Astro.props;

/* The sitewide share card. Its dimensions are declared to the scrapers so the
   preview renders on the first fetch rather than after they have downloaded and
   measured the file — without them, the first share of a URL often shows as a
   bare text link.

   Note the source is 1750x1050 (5:3). Facebook and X crop share cards to
   1.91:1 and 2:1, so the top and bottom edges get shaved; keep anything
   essential away from them, or drop in a 1200x630 export at the same path. */
const DEFAULT_SHARE_IMAGE = {
  src: '/social-share.png',
  alt: 'Joy Within Birth — faith-centered natural childbirth training with Hailey Joy Aliff',
  width: 1750,
  height: 1050,
};

const shareImage = image ? { src: image, width: null, height: null } : DEFAULT_SHARE_IMAGE;
const shareImageAlt = imageAlt ?? DEFAULT_SHARE_IMAGE.alt;

const siteTitle = `${title} | Joy Within Birth`;
const socialTitle = ogTitle ?? siteTitle;

/* Open Graph rejects relative paths, so everything below is resolved against
   `site` in astro.config.mjs. */
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const shareImageUrl = new URL(shareImage.src, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{siteTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.png" type="image/png" />

    {/* Open Graph — Facebook, iMessage, WhatsApp, Slack, Pinterest, LinkedIn. */}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Joy Within Birth" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:alt" content={shareImageAlt} />
    {shareImage.width && <meta property="og:image:width" content={String(shareImage.width)} />}
    {shareImage.height && <meta property="og:image:height" content={String(shareImage.height)} />}

    {/* X/Twitter reads the og:* tags for anything it omits here. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    <link
      rel="preload"
      href="/fonts/lindsey-signature/LindseySignature.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Arms the scroll-reveal styles in global.css, which hide [data-reveal]
        content until it scrolls in.

        Set inline and in <head> so it lands before first paint — there is no
        flash of visible-then-hidden content. But "scripting exists" is the wrong
        thing to condition on: what actually reveals these elements again is
        Alpine's x-intersect, so if the Alpine bundle is slow, blocked, or errors
        out, the guard alone would leave most of the page permanently blank.

        So it is withdrawn again unless Alpine has booted. `alpine:init` fires
        when it does; the timeout is the failsafe for when it never does, and
        both paths converge on visible content. 2500ms is well past a normal boot
        while still short enough that a genuinely broken bundle self-heals before
        a reader has scrolled far. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('reveal-ready');

        let booted = false;
        document.addEventListener('alpine:init', () => { booted = true; }, { once: true });

        window.setTimeout(() => {
          if (!booted) root.classList.remove('reveal-ready');
        }, 2500);
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main
      x-data="{
        updateScrollScaleImages() {
          const viewportHeight = window.innerHeight;

          document.querySelectorAll('[data-scroll-scale-image]').forEach((image) => {
            const frame = image.parentElement;
            const rect = frame.getBoundingClientRect();

            if (rect.bottom < 0 || rect.top > viewportHeight) return;

            const progress = Math.min(1, Math.max(0, (viewportHeight - rect.top) / (viewportHeight + rect.height)));
            const scale = 1.04 + progress * 0.16;

            image.style.transform = `scale(${scale})`;
          });
        }
      }"
      x-init="
        updateScrollScaleImages();
        window.addEventListener('scroll', () => requestAnimationFrame(() => updateScrollScaleImages()), { passive: true });
        window.addEventListener('resize', () => requestAnimationFrame(() => updateScrollScaleImages()), { passive: true });
      "
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
